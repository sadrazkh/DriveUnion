{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // ConnectionStrings is deliberately absent. The panel's Postgres password lives in user-secrets
  // and nowhere else, so this file can stay in the repository:
  //
  //   dotnet user-secrets set "ConnectionStrings:Default" "Host=…;Password=…" --project src/DriveUnion.Web
  //
  // An empty "Password=" here would be worse than nothing: Program.cs would find a connection
  // string, hand it to Npgsql, and the failure would be a question about a password rather than
  // the sentence in Program.cs naming the key that was never set.

  "Google": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": ""
  },

  // Web Push. Present and empty as documentation of the keys, exactly like Google above: blank
  // counts as absent, so the notifications screen says "not set up yet" and no subscribe control is
  // drawn — a subscription minted against a key this server has no private half of is a row that
  // answers 403 for ever.
  //
  // PrivateKey never goes in a file. It is what proves a message came from this deployment, so it
  // belongs in user-secrets locally and in the environment in production:
  //
  //   dotnet user-secrets set "Push:PrivateKey" "…" --project src/DriveUnion.Web
  //
  // The pair is a P-256 key: PublicKey is the 65-byte uncompressed point and PrivateKey the 32-byte
  // scalar, both base64url. VapidCredentials.Generate() makes one, and refuses a mismatched pair on
  // start-up rather than letting every push answer 403 with nothing anywhere saying why. Subject is
  // a mailto: or https: address a push service can use to reach whoever runs this.
  "Push": {
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": ""
  },
  "DriveUnion": {
    "PublicBaseUrl": "http://localhost:5099",
    "PublicDesignGuide": true,
    "S3": {
      // Where multipart parts are staged before assembly into one Drive upload. Off by default
      // in production too — see S3StagingOptions for why it is not defaulted to a temp path.
      "StagingDirectory": "E:\\DriveUnionStaging",
      "MinFreeBytes": 0
    },
    "LocalDisk": {
      "Enabled": true,
      "RootPath": "E:\\DriveUnionFiles"
    }
  }
}
