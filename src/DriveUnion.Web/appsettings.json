{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DriveUnion": {
    // Deliberately absent, not "https://example.invalid".
    //
    // Every share link the product hands out is built from this. The code already falls back to the
    // address the request arrived on when nothing is configured, which is right for a deployment
    // that has not been told its own domain yet — but a placeholder here is a configured value, so
    // the fallback never ran and every link read https://example.invalid/d/xxxxxxxx.
    //
    // Set it when the panel is reachable at an address the request cannot see: behind a CDN, or on a
    // second hostname. Otherwise leaving it out is correct.
    //
    // "PublicBaseUrl": "https://files.example.com",


    // Turn on when the panel runs behind a proxy that terminates TLS and is the only thing that can
    // reach it — Harbora's is. Left off, X-Forwarded-Proto and X-Forwarded-For are dropped, and the
    // symptom is silent: an https panel that believes it is http, and every visitor sharing one
    // address. Name the proxy in TrustedProxies instead when its address is stable.
    "TrustAnyProxy": false,
    "TrustedProxies": []
  }
}
