            <div>@UiText.Design.ColumnAccount</div>
            <div>@UiText.Files.ColumnSize</div>
            <div>@UiText.Files.ColumnModified</div>
            <div>@UiText.Files.ColumnLinks</div>
            <div>@UiText.Links.ColumnDownloads</div>
        </div>
