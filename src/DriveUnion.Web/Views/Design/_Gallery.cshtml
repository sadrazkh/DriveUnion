<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.LoadingState</h3>
<p class="muted" style="font-size: 11.5px; margin: 0 0 10px;">
    @UiText.Design.SkeletonNoteBefore<span class="mono" dir="ltr">--row-pad</span>@UiText.Design.SkeletonNoteAfter
</p>
<div class="card card--flush" style="margin-bottom: 22px;">
    <div class="dtable" style="@Cols">
        <div class="dtable-head">
            <div></div>
            <div>@UiText.Files.ColumnName</div>
            <div>@UiText.Design.ColumnAccount</div>
            <div>@UiText.Files.ColumnSize</div>
            <div>@UiText.Files.ColumnModified</div>
            <div>@UiText.Files.ColumnLinks</div>
            <div>@UiText.Links.ColumnDownloads</div>
        </div>
        @for (var i = 0; i < 4; i++)
        {
            <div class="skeleton-row">
                <div><span class="skeleton skeleton--box"></span></div>
                <div><span class="skeleton skeleton--short"></span></div>
                <div><span class="skeleton"></span></div>
                <div><span class="skeleton"></span></div>
                <div><span class="skeleton"></span></div>
                <div><span class="skeleton"></span></div>
                <div><span class="skeleton"></span></div>
            </div>
        }
    </div>
</div>

<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.EmptyState</h3>
<div class="card card--flush" style="margin-bottom: 22px;">
    <div class="dtable" style="@Cols">
        <div class="dtable-head">
            <div></div>
            <div>@UiText.Files.ColumnName</div>
            <div>@UiText.Design.ColumnAccount</div>
            <div>@UiText.Files.ColumnSize</div>
            <div>@UiText.Files.ColumnModified</div>
            <div>@UiText.Files.ColumnLinks</div>
            <div>@UiText.Links.ColumnDownloads</div>
        </div>
        <div class="empty empty--incell">
            <span>@UiText.Files.EmptyStateHeading</span>
