        </div>
    </div>
</div>

<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.ProgressBars</h3>
<div class="card card--pad" style="margin-bottom: 22px;">
    <div class="bar-label"><span>@UiText.Accounts.StorageUsed</span><span class="mono" dir="ltr">3.42 / 5 TB</span></div>
    <div class="bar bar--lg" style="margin-bottom: 16px;"><span class="bar-fill" style="width: 68%"></span></div>

    <div class="bar-label"><span>@UiText.Design.QuotaUnder80</span><span class="mono" dir="ltr">306 / 750 GB</span></div>
    <div class="bar bar--lg" style="margin-bottom: 16px;"><span class="bar-fill" style="width: 40.8%"></span></div>

    <div class="bar-label"><span>@UiText.Design.QuotaOver80</span><span class="mono" dir="ltr">612 / 750 GB</span></div>
    <div class="bar bar--lg" style="margin-bottom: 16px;"><span class="bar-fill bar-fill--warn" style="width: 81.6%"></span></div>

    <div class="bar-label"><span>@UiText.Design.QuotaOver95</span><span class="mono" dir="ltr">728 / 750 GB</span></div>
    <div class="bar bar--lg" style="margin-bottom: 16px;"><span class="bar-fill bar-fill--danger" style="width: 97.1%"></span></div>

    <div class="bar-label"><span>@UiText.Design.BarInRow</span><span class="mono" dir="ltr">73%</span></div>
    <div class="bar"><span class="bar-fill" style="width: 73%"></span></div>

    <p class="muted" style="font-size: 11.5px; margin: 12px 0 0;">
        @UiText.Design.QuotaRule1<span class="mono" dir="ltr">--warn</span>@UiText.Design.QuotaRule2<span class="mono" dir="ltr">--danger</span>@UiText.Design.QuotaRule3<span class="mono" dir="ltr">ShellContext.QuotaFillClass</span>@UiText.Design.QuotaRule4
    </p>
</div>

<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.FormControls</h3>
<div class="card card--pad" style="margin-bottom: 22px;">
    <label class="field-label" for="slug-@s">@UiText.Design.CustomAddress</label>
    <div class="field" dir="ltr" style="margin-bottom: 16px;">
        <span class="field-prefix">yourdomain.com/d/</span>
        <input id="slug-@s" value="kx91mz" />
    </div>

    <span class="field-label">@UiText.Design.ExpiryDate</span>
    <div class="seg" style="margin-bottom: 16px;">
        <button type="button" class="seg-option">@UiText.Design.Expiry24Hours</button>
        <button type="button" class="seg-option is-active">@UiText.Design.Expiry14Days</button>
        <button type="button" class="seg-option">@UiText.Links.ExpiryNone</button>
    </div>

    <div class="switch-row">
        <span>
            <span class="switch-label">@UiText.Design.PasswordProtect</span>
            <span class="switch-hint" style="display: block;">@UiText.Design.PasswordProtectHint</span>
        </span>
        <button type="button" class="switch is-on" role="switch" aria-checked="true">
            <span class="visually-hidden">@UiText.Design.PasswordProtect</span>
        </button>
    </div>
    <div class="switch-row" style="margin-bottom: 16px;">
        <span>
            <span class="switch-label">@UiText.Design.HideRealName</span>
            <span class="switch-hint" style="display: block;">@UiText.Design.HideRealNameHint</span>
        </span>
        <button type="button" class="switch" role="switch" aria-checked="false">
            <span class="visually-hidden">@UiText.Design.HideRealName</span>
        </button>
    </div>

    <span class="field-label">@UiText.Design.DownloadCap</span>
    <div class="row" style="gap: 10px; margin-bottom: 16px;">
        <span class="slider">
            <span class="slider-fill" style="width: 48%"></span>
            <span class="slider-thumb" style="inset-inline-start: 48%"></span>
        </span>
        <span class="mono" style="font-size: 12.5px;">500</span>
    </div>

    <span class="field-label">@UiText.Design.UploadPolicy</span>
    <div class="stack" style="gap: 8px;">
        <button type="button" class="radio-card is-selected">
            <span class="radio-mark" aria-hidden="true"></span>
            <span>
                <span style="display: block; font-size: 13px; font-weight: 600;">@UiText.Design.PolicyMostFree</span>
                <span class="muted" style="display: block; font-size: 11px;">@UiText.Design.PolicyMostFreeHint</span>
            </span>
        </button>
        <button type="button" class="radio-card">
            <span class="radio-mark" aria-hidden="true"></span>
            <span>
                @* «round-robin» is the scheduling algorithm's name and is the same word in both. *@
                <span style="display: block; font-size: 13px; font-weight: 600;">round-robin</span>
                <span class="muted" style="display: block; font-size: 11px;">@UiText.Design.PolicyRoundRobinHint</span>
            </span>
        </button>
    </div>
</div>

<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.Cards</h3>
<div class="grid-2" style="margin-bottom: 22px;">
    <div class="card card--pad">
        <h4 class="card-title" style="margin-bottom: 8px;">@UiText.Design.CardMain</h4>
        <p class="muted" style="margin: 0; font-size: 12.5px;">@UiText.Design.CardNote<span class="mono" dir="ltr">--shadow</span></p>
        <div class="subcard" style="margin-top: 14px;">
            <span style="font-size: 12.5px; font-weight: 700;">@UiText.Design.CardInner</span>
            <span class="badge push-end">@UiText.Files.PublicBadge</span>
        </div>
    </div>
    <div class="stack" style="gap: 12px;">
        <div class="card card--stat">
            <div class="muted" style="font-size: 11.5px; margin-bottom: 6px;">@UiText.Design.TotalSpeed</div>
            <div class="mono" style="font-size: 22px; font-weight: 800;" dir="ltr">341 <span class="muted" style="font-size: 12px; font-weight: 500;">MB/s</span></div>
        </div>
        <div class="card--dashed" style="text-align: center; font-size: 12.5px;">
            @UiText.Design.AddThirdAccount
        </div>
    </div>
</div>

<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.PreviewPlaceholder</h3>
<div class="card card--flush" style="margin-bottom: 22px;">
    <div class="ph" style="height: 150px;">
        <span class="ph-label">@UiText.Design.PdfFirstPage</span>
    </div>
</div>

<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.PublicCard</h3>
<div class="public-card" style="margin-bottom: 22px;">
