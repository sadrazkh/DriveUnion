        <div class="meta-grid">
            <div class="meta-cell">
                <div class="meta-label">@UiText.Design.MetaSize</div>
                <div class="meta-value mono" dir="ltr">18.4 MB</div>
            </div>
            <div class="meta-cell">
                <div class="meta-label">@UiText.Design.MetaType</div>
                <div class="meta-value mono" dir="ltr">PDF</div>
