@model string
@{
    @* The model is the theme this copy is rendered in ("light" / "dark"). It only exists to keep
       element ids unique — the gallery is on the page twice and duplicate ids break every label. *@
    var s = Model;
    // The comp's seven tracks, with the name column's floor from --name-min in app.css — the same
    // change the two real tables carry, because a specimen that cannot show the narrow case is not
    // a specimen of it.
    const string Cols = "--cols: 28px minmax(var(--name-min),2.4fr) 84px 92px 110px 118px 96px";
}

@*
    The specimens are rendered in whichever language the panel is in, and that is the point of them:
    the English labels are longer than the Persian ones, so a gallery that could only draw Persian
    could not be used to find the column they overflow. Two things stay Persian on purpose and say
    so in the catalogue — the Persian file name in the name column, which is an RTL-inside-LTR
    rendering case, and the numeral specimens, which are what PersianDigits produces.

    Everything Latin here is sample data rather than copy: a file name, an account label, a byte
    size, a slug, a speed. None of it is translated and none of it belongs in the catalogue.
*@

<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.Buttons</h3>
<div class="card card--pad" style="margin-bottom: 22px;">
    <div class="row" style="flex-wrap: wrap; gap: 10px; margin-bottom: 14px;">
        <button type="button" class="btn btn--primary">@UiText.Design.ButtonPrimary</button>
        <button type="button" class="btn">@UiText.Design.ButtonOutline</button>
        <button type="button" class="btn btn--danger">@UiText.Files.RevokeLink</button>
        <button type="button" class="btn btn--sm">@UiText.Design.ButtonSmall</button>
        <button type="button" class="btn btn--primary btn--lg">@UiText.Shell.Upload</button>
        <button type="button" class="btn btn--dashed">@UiText.Design.ButtonPreviewPublic</button>
        <button type="button" class="btn btn--primary" disabled>@UiText.Design.ButtonDisabled</button>
        <button type="button" class="btn" disabled>@UiText.Design.ButtonDisabledOutline</button>
    </div>
    <button type="button" class="btn btn--primary btn--cta">@UiText.Design.DownloadFile</button>
    <p class="muted" style="font-size: 11.5px; margin: 12px 0 0;">
        @UiText.Design.ButtonsNoteBefore<span class="mono" dir="ltr">0 8px 20px -10px var(--accent)</span>@UiText.Design.ButtonsNoteAfter
    </p>
</div>

<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.BadgesAndChips</h3>
<div class="card card--pad" style="margin-bottom: 22px;">
    <div class="row" style="flex-wrap: wrap; gap: 8px; margin-bottom: 14px;">
        <span class="badge">@UiText.Accounts.StatusHealthy</span>
        <span class="badge badge--warn">@UiText.Links.StatusNearCap</span>
        <span class="badge badge--danger">@UiText.Design.BadgeFailed</span>
        <span class="badge badge--muted">@UiText.Links.StatusExpired</span>
        <span class="badge badge--count">@Numerals.Count(3)</span>
    </div>
    <div class="row" style="flex-wrap: wrap; gap: 8px;">
        <button type="button" class="chip is-active">@UiText.Design.ChipAllAccounts</button>
        <button type="button" class="chip">A1 archive.main</button>
        <button type="button" class="chip">A2 archive.cold</button>
        <button type="button" class="chip">@UiText.Design.ChipWithLinksOnly</button>
        <button type="button" class="chip">@UiText.Design.ChipLargerThan</button>
    </div>
</div>

<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.TableComfortable</h3>
