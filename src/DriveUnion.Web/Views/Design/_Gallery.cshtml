    <div class="public-foot">
        <span class="mono" dir="ltr">yourdomain.com/d/kx91mz</span>
        <span>@UiText.Design.SampleDownloadCount(241)</span>
    </div>
</div>

<h3 class="section-title" style="margin-bottom: 12px;">@UiText.Design.PublicStates</h3>
<div class="grid-2" style="margin-bottom: 6px;">
    @* Same card, no call to action, no metadata. An unknown slug renders this too — the response
       must not reveal whether a slug exists (spec §7). *@
    <div class="public-card">
        <div class="public-body" style="text-align: center;">
            <span class="badge badge--muted" style="margin-bottom: 12px;">@UiText.Design.PublicUnavailableBadge</span>
            <h4 class="public-title" style="font-size: 20px;">@UiText.Design.PublicUnavailableHeading</h4>
            <p class="public-desc" style="margin: 0 auto;">@UiText.Design.PublicUnavailableBody</p>
        </div>
    </div>
    <div class="public-card">
        <div class="public-body">
            <span class="badge" style="margin-bottom: 12px;">@UiText.Design.PublicProtectedBadge</span>
            <h4 class="public-title" style="font-size: 20px;">@UiText.Design.PublicProtectedHeading</h4>
            <label class="field-label" for="pw-@s">@UiText.Design.PublicPasswordLabel</label>
            <div class="field" dir="ltr" style="margin-bottom: 14px;">
                <input id="pw-@s" type="password" value="" placeholder="••••••••" />
            </div>
            <button type="button" class="btn btn--primary btn--block">@UiText.Design.PublicContinue</button>
        </div>
    </div>
</div>
