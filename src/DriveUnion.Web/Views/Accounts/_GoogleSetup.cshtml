@using DriveUnion.Infrastructure.Google
@using DriveUnion.Web.Models
@model GoogleSetupViewModel
@{
    // Open when there is nothing in force. This is the first screen a new operator meets and it has
    // to read as instructions; once a client is configured it folds away, because after that the
    // page is about the accounts and not about how to make accounts possible.
    var expanded = !Model.IsComplete;

    string SourceClass(GoogleCredentialSource source) => source switch
    {
        GoogleCredentialSource.None => "badge badge--warn",
        GoogleCredentialSource.Configuration => "badge badge--muted",
        _ => "badge",
    };
}

@*
    id="google-setup" is the target of the accounts screen's primary action when there is nothing to
    connect with. It is what makes that button a route rather than a dead end, with no script
    involved: the browser's own fragment navigation lands here, and the panel is already unfolded
    because it is incomplete.

    Every step below is a sentence with a Google term set into it, and the term lands in a different
    place in each language — so the catalogue supplies the sentence in the fragments either side of
    it rather than one string with a placeholder. What is inside the mono, dir="ltr" boxes is
    Google's own spelling of a screen, a menu path, a mode or a scope, and it is never translated:
    the operator is going to hunt for exactly those characters in Google Cloud.
*@
<details class="setup" id="google-setup" @(expanded ? "open" : null)>
    <summary class="setup-summary">
        <span class="setup-summary-text">
            <span class="setup-summary-title">@UiText.Accounts.SetUpGoogle</span>
            <span class="setup-summary-sub">
                @if (Model.IsComplete)
                {
                    <text>@UiText.Accounts.SetupComplete</text>
                }
                else
                {
                    @* Why the client is needed is said once, next to the button that cannot connect
                       without it. This says what is inside the panel instead of repeating it. *@
                    <text>@UiText.Accounts.SetupIncomplete</text>
                }
            </span>
        </span>
        <span class="@(Model.IsComplete ? "badge" : "badge badge--warn")">
            @(Model.IsComplete ? UiText.Accounts.SetupReady : UiText.Accounts.SetupUnfinished)
        </span>
    </summary>

    <div class="setup-body">
        @*
            The steps, in the order Google Cloud actually presents them. Written out rather than
            linked to Google's documentation because that documentation is in English, changes
            without notice, and does not know what this panel's redirect URI is.
        *@
        <ol class="setup-steps">
            <li>@UiText.Accounts.StepProjectBefore<a href="https://console.cloud.google.com/projectcreate" target="_blank" rel="noopener noreferrer">Google Cloud Console</a>@UiText.Accounts.StepProjectAfter</li>
            <li>@UiText.Accounts.StepApiBefore<span class="mono" dir="ltr">APIs &amp; Services → Library</span>@UiText.Accounts.StepApiMiddle<span class="mono" dir="ltr">Google Drive API</span>@UiText.Accounts.StepApiAfter</li>
            <li>@UiText.Accounts.StepClientBefore<span class="mono" dir="ltr">Credentials → Create credentials → OAuth client ID</span>@UiText.Accounts.StepClientMiddle<span class="mono" dir="ltr">Web application</span>@UiText.Accounts.StepClientAfter</li>
            <li>
                @UiText.Accounts.StepRedirectBefore<span class="mono" dir="ltr">Authorised redirect URIs</span>@UiText.Accounts.StepRedirectAfter

                @*
                    Rendered from this request's own scheme, host and port. Google compares the two
                    strings byte for byte and answers a mismatch with redirect_uri_mismatch and
                    nothing else, so the operator must not be assembling this by hand.
                *@
                <span class="setup-copy">
                    <code class="setup-uri mono" dir="ltr" data-copy-value>@Model.SuggestedRedirectUri</code>
                    <button type="button" class="btn btn--sm" data-copy hidden>@UiText.Accounts.CopyUri</button>
                </span>

                @if (Model.RedirectUriSource is not GoogleCredentialSource.None
                     && !string.Equals(Model.RedirectUri, Model.SuggestedRedirectUri, StringComparison.Ordinal))
                {
                    <span class="setup-note">
                        @UiText.Accounts.RedirectUriDiffers
                        <span class="mono" dir="ltr">@Model.RedirectUri</span>
                    </span>
                }
            </li>
            <li>
                <strong>@UiText.Accounts.StepConsentBefore<span class="mono" dir="ltr">Testing</span>@UiText.Accounts.StepConsentMiddle<span class="mono" dir="ltr">In production</span>@UiText.Accounts.StepConsentAfter</strong>
                @UiText.Accounts.StepConsentWhy
            </li>
            <li>@UiText.Accounts.StepScopeBefore<span class="mono" dir="ltr">@GoogleSetupViewModel.Scope</span>@UiText.Accounts.StepScopeAfter</li>
        </ol>

        @* What is in force right now, and why. Three rows, because the operator's next question
           after "it does not work" is always "which of the three is missing". The row labels are
           Google's own names for the three values and are not translated. *@
        <div class="setup-state" role="group" aria-label="@UiText.Accounts.CurrentState">
            <div class="setup-state-row">
                <span class="setup-state-label">Client ID</span>
                <span class="setup-state-value mono" dir="ltr">@(Model.ClientId.Length > 0 ? Model.ClientId : "—")</span>
                <span class="@SourceClass(Model.ClientIdSource)">@GoogleSetupViewModel.SourceText(Model.ClientIdSource)</span>
            </div>
            <div class="setup-state-row">
                <span class="setup-state-label">Client Secret</span>
                @* Never the value. «ذخیره شده» is the whole of what a browser is ever told. *@
                <span class="setup-state-value">@(Model.SecretIsSet ? UiText.Accounts.SecretStored : "—")</span>
                <span class="@SourceClass(Model.SecretSource)">@GoogleSetupViewModel.SourceText(Model.SecretSource)</span>
            </div>
            <div class="setup-state-row">
                <span class="setup-state-label">Redirect URI</span>
                @* The attribute names which element carries the value in force. A test reads it and
                   compares it with the redirect_uri the authorization request actually sends — a
                   mismatch between those two is the classic hour-long debugging session, and Google
                   reports it as nothing more than «redirect_uri_mismatch». *@
                <span class="setup-state-value mono" dir="ltr" data-effective-redirect-uri>@Model.RedirectUri</span>
                <span class="@SourceClass(Model.RedirectUriSource)">@GoogleSetupViewModel.SourceText(Model.RedirectUriSource)</span>
            </div>
        </div>

        @if (Model.ConfigurationOutranksPanel)
        {
            <p class="setup-note setup-note--warn" role="status">
                @UiText.Accounts.ConfigurationOutranksBefore<span class="mono" dir="ltr">@UiText.Accounts.ConfigurationKeys</span>@UiText.Accounts.ConfigurationOutranksAfter
            </p>
        }
        else
        {
            @*
                The three settings, named, beside the form that is the other way of supplying them.
                This used to be a red paragraph at the foot of the accounts screen — nowhere near
                either of the two things it is about. A deployment that does have a terminal should
                know the environment is an option, and that it wins.
            *@
            <p class="setup-note">
                @UiText.Accounts.EnvironmentAlternativeBefore<span class="mono" dir="ltr">@UiText.Accounts.ConfigurationKeys</span>@UiText.Accounts.EnvironmentAlternativeAfter
            </p>
        }

        <form class="setup-form" method="post" action="@Url.Action("SaveGoogleCredentials", "Accounts")">
            @Html.AntiForgeryToken()

            <div class="stack" style="gap: 4px;">
                <label class="field-label" for="setup-client-id">Client ID</label>
                <span class="field">
                    @* Named for the enhancement rather than found by position: the first <input> in
                       this panel is the antiforgery token, and focusing that does nothing visible. *@
                    <input id="setup-client-id"
                           name="ClientId"
                           data-setup-focus
                           dir="ltr"
                           autocomplete="off"
                           spellcheck="false"
                           placeholder="123456789-abc.apps.googleusercontent.com"
                           value="@Model.FormClientId" />
                </span>
            </div>

            <div class="stack" style="gap: 4px;">
                <label class="field-label" for="setup-client-secret">Client Secret</label>
                @*
                    type=password so a shoulder or a screen share does not read it, and no value
                    attribute ever — the secret leaves this server exactly once, on its way to
                    Google. Blank means «unchanged», which the placeholder says.
                *@
                <span class="field">
                    <input id="setup-client-secret"
                           name="ClientSecret"
                           type="password"
                           dir="ltr"
                           autocomplete="off"
                           spellcheck="false"
                           placeholder="@(Model.StoredSecretIsSet ? UiText.Accounts.SecretPlaceholder : "GOCSPX-…")" />
                </span>
            </div>

            <div class="stack" style="gap: 4px;">
                <label class="field-label" for="setup-redirect-uri">Redirect URI</label>
                <span class="field">
                    <input id="setup-redirect-uri"
                           name="RedirectUri"
                           dir="ltr"
                           autocomplete="off"
                           spellcheck="false"
                           value="@Model.FormRedirectUri" />
                </span>
                <span class="setup-hint">@UiText.Accounts.RedirectUriHint</span>
            </div>

            <div class="row" style="gap: 8px;">
                <button type="submit" class="btn btn--primary">@UiText.Accounts.Save</button>

                @if (Model.HasStoredClient)
                {
                    <span class="setup-hint push-end">@UiText.Accounts.LastChanged(Model.StoredUpdatedText ?? string.Empty)</span>
                }
            </div>
        </form>

        @if (Model.HasStoredClient)
        {
            @* A separate form, because a delete inside the save form is one stray Enter away from
               being the button that submits. *@
            <form method="post" action="@Url.Action("ClearGoogleCredentials", "Accounts")">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn--danger btn--sm">@UiText.Accounts.DeleteStored</button>
            </form>
        }
    </div>
</details>
