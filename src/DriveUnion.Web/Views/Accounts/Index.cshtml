@using DriveUnion.Web.Models
@model AccountsPageViewModel
@{
    ViewData["Title"] = "اکانت‌های گوگل";
}

@*
    accounts.css carries the OAuth popup's card and this screen's setup panel. The link is here
    rather than in the head because _Layout has no head section to extend and this is the only
    panel view that needs the file — the browser still blocks rendering of what follows while it
    loads, so there is nothing to flash. Every other page pays nothing for it.
*@
<link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />

<div class="stack" style="gap: 16px;">
    <div class="row">
        <div class="stack" style="gap: 4px;">
            <h1 class="page-title">اکانت‌های گوگل</h1>
            <p class="page-sub">توکن‌ها رمزنگاری‌شده روی سرور ذخیره می‌شوند.</p>
        </div>

        <form class="push-end" method="post" action="@Url.Action("Connect", "Accounts")" data-google-connect>
            @Html.AntiForgeryToken()
            @*
                Scripts/googleConnect.ts flips this to "true" only after window.open has actually
                handed it a window, and points the form's target at that window. Posted in the body
                of the request antiforgery already protects — never a query parameter — because the
                controller carries this flag through Google and back to decide whether the callback
                answers with a page that talks to window.opener.

                Untouched it stays "false", which is the same-tab flow: no JavaScript, or a blocked
                popup, both land here.
            *@
            <input type="hidden" name="popup" value="false" data-google-connect-popup />
            <button type="submit" class="btn btn--primary btn--lg" @(Model.ConsentConfigured ? null : "disabled")>
                + افزودن اکانت با OAuth
            </button>
        </form>
    </div>

    @* Written by the popup enhancement only. Rendered hidden and empty so no reader meets a label
       for a window that was never opened. *@
    <p class="page-sub" role="status" data-google-connect-status hidden></p>

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <p class="page-sub" role="status">@Model.Notice</p>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="page-sub" role="alert" style="color: var(--danger);">@Model.Error</p>
    }

    @*
        The setup panel, above the accounts and not below them, because with nothing configured
        there are no accounts to be below. It is the whole answer to «چطور شروع کنم؟» and it is
        rendered on every visit, folded, so changing a client id later is not a hunt.
    *@
    <partial name="_GoogleSetup" model="Model.Setup" />

    @if (!Model.ConsentConfigured)
    {
        <p class="page-sub" style="color: var(--danger);">
            تا وقتی هر سه‌ی <span class="mono" dir="ltr">Google:ClientId</span>،
            <span class="mono" dir="ltr">Google:ClientSecret</span> و
            <span class="mono" dir="ltr">Google:RedirectUri</span> — از پیکربندی سرور یا از فرم بالا —
            تأمین نشوند، اتصال اکانت ممکن نیست.
        </p>
    }

    @if (Model.Accounts.Count == 0)
    {
        <div class="card card--flush">
            <div class="empty">
                <span>هیچ اکانتی متصل نیست. تا وقتی یک اکانت متصل نشود، آپلود کار نمی‌کند.</span>
            </div>
        </div>
    }

    @foreach (var account in Model.Accounts)
    {
        <div class="card card--pad" style="max-width: 900px;">
            <div class="row" style="gap: 16px; align-items: flex-start;">
                <span class="brand-mark" aria-hidden="true">@account.Label</span>

                <span class="stack" style="gap: 4px; flex: 1; min-width: 0;">
                    <span class="mono" dir="ltr" style="font-size: 14px; font-weight: 700;">@account.Email</span>
                    <span class="mono muted" dir="ltr" style="font-size: 11px;">scope: drive</span>
                </span>

                <span class="badge @(account.Status == GoogleAccountStatus.Healthy ? null : "badge--warn")">
                    @account.StatusText
                </span>
            </div>

            <div style="margin-top: 14px; max-width: 320px;">
                <div class="bar-label">
                    <span>فضای مصرفی</span>
                    <span class="mono" dir="ltr">@account.UsedText / @account.TotalText</span>
                </div>
                @* The width is this account's own reading, not styling — it cannot live in a stylesheet. *@
                <div class="bar bar--lg"><span class="bar-fill" style="width: @(account.UsedPercent)%"></span></div>
            </div>

            <div class="row" style="gap: 8px; margin-top: 16px;">
                <form method="post" action="@Url.Action("RefreshQuota", "Accounts", new { id = account.Id })">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn--sm">تازه‌سازی فضا</button>
                </form>
                <form method="post" action="@Url.Action("Disconnect", "Accounts", new { id = account.Id })">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn--danger btn--sm">قطع اتصال</button>
                </form>
            </div>
        </div>
    }
</div>
