@using DriveUnion.Web.Models
@model AccountsPageViewModel
@{
    ViewData["Title"] = UiText.Accounts.Title;

    // The setup panel's fragment, spelled once. Three things have to name the same element or the
    // primary action becomes a link that appears to do nothing: this href, the <details> the
    // partial renders, and the script that opens it and puts the caret in the first field.
    const string SetupPanel = "google-setup";
}

@*
    accounts.css carries the OAuth popup's card and this screen's setup panel. The link is here
    rather than in the head because _Layout has no head section to extend and this is the only
    panel view that needs the file — the browser still blocks rendering of what follows while it
    loads, so there is nothing to flash. Every other page pays nothing for it.
*@
<link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />

<div class="stack" style="gap: 16px;">
    <div class="accounts-head">
        <div class="stack" style="gap: 4px;">
            <h1 class="page-title">@UiText.Accounts.Title</h1>
            <p class="page-sub">@UiText.Accounts.Subtitle</p>
        </div>

        <div class="accounts-cta">
            @if (Model.ConsentConfigured)
            {
                <form method="post" action="@Url.Action("Connect", "Accounts")" class="accounts-connect" data-google-connect>
                    @Html.AntiForgeryToken()
                    @*
                        Scripts/googleConnect.ts flips this to "true" only after window.open has actually
                        handed it a window, and points the form's target at that window. Posted in the body
                        of the request antiforgery already protects — never a query parameter — because the
                        controller carries this flag through Google and back to decide whether the callback
                        answers with a page that talks to window.opener.

                        Untouched it stays "false", which is the same-tab flow: no JavaScript, or a blocked
                        popup, both land here.
                    *@
                    <input type="hidden" name="popup" value="false" data-google-connect-popup />
                    @* aria-describedby is bound to the sentence below only when that sentence is
                       rendered; Razor drops an attribute whose value is null, so this never points at
                       an element that is not there. *@
                    <button type="submit"
                            class="btn btn--primary btn--lg"
                            aria-describedby="@(Model.Accounts.Count > 0 ? "accounts-add-why" : null)">
                        @* Two labels, because these are two intentions. With nothing connected this is
                           the first account; with a pool already on screen it is another one — and the
                           per-card «reconnect» beside each account is the other half of the pair. They
                           used to be the same control, and a second press of it silently re-approved
                           the account the browser was already signed into. *@
                        @(Model.Accounts.Count == 0 ? UiText.Accounts.AddAccount : UiText.Accounts.AddAnotherAccount)
                    </button>

                    @* Written by the popup enhancement only. Rendered hidden and empty so no reader meets a
                       label for a window that was never opened, and inside the form so the script finds it
                       by looking in one place — the per-account reconnect forms are the same markup with
                       no status element, and a lookup that walked the DOM around each form would have to
                       guess which paragraph belonged to which button.

                       The sentence itself rides on the element as data-*: the bundle is compiled once and
                       cannot ask which language this request is in, and it used to answer an English
                       operator in Persian. *@
                    <p class="page-sub"
                       role="status"
                       data-google-connect-status
                       data-said-opened="@UiText.Accounts.ConnectPopupOpened"
                       hidden></p>
                </form>

                @if (Model.Accounts.Count > 0)
                {
                    @* The chooser, announced before it appears. An operator who has already met the old
                       behaviour needs to be told that Google now asks — and that answering it with the
                       account already in the list is a reconnection, not a second account. *@
                    <p class="accounts-cta-why" id="accounts-add-why">@UiText.Accounts.AddAnotherHint</p>
                }
            }
            else
            {
                @*
                    Never disabled. Google will not take a request without a client id — that part is
                    Google's and cannot be undone here — but a primary action that refuses to depress
                    and offers nothing instead reads as a broken product rather than as an unfinished
                    setup. So the control keeps working and does the only thing that is actually next:
                    it goes to the form that produces what is missing. The label promises that and not
                    a connection. Plain anchor to the panel's fragment, so this works with no script at
                    all; googleConnect.ts adds the unfolding, the scroll and the focus.
                *@
                <a class="btn btn--primary btn--lg"
                   href="#@SetupPanel"
                   aria-describedby="accounts-cta-why"
                   data-setup-jump>@UiText.Accounts.SetUpGoogle</a>

                @*
                    The refusal, explained where the refusal happens. The detailed instructions stay in
                    the panel; this is the one sentence an operator needs before they scroll — including
                    the part no amount of engineering removes, said plainly and said once.

                    No whitespace around the term: the punctuation that follows «Client ID» belongs to
                    the sentence and differs between the two languages, so the catalogue carries it.
                *@
                <p class="accounts-cta-why" id="accounts-cta-why">@UiText.Accounts.ConsentNeedsClientBefore<span class="mono" dir="ltr">Client ID</span>@UiText.Accounts.ConsentNeedsClientAfter</p>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <p class="page-sub" role="status">@Model.Notice</p>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="page-sub" role="alert" style="color: var(--danger);">@Model.Error</p>
    }

    @*
        The setup panel, above the accounts and not below them, because with nothing configured
        there are no accounts to be below. It is the whole answer to «چطور شروع کنم؟» and it is
        rendered on every visit, folded, so changing a client id later is not a hunt.

        It used to be followed by a red paragraph naming the three settings — an explanation for a
        refusal that had happened several screens earlier, which is where nobody was looking. The
        reason now sits with the control, and the settings are named inside the panel, beside the
        form that is the other way of supplying them.
    *@
    <partial name="_GoogleSetup" model="Model.Setup" />

    @if (Model.Accounts.Count == 0)
    {
        <div class="card card--flush">
            <div class="empty">
                @if (Model.ConsentConfigured)
                {
                    <span>@UiText.Accounts.EmptyConfigured</span>
                }
                else
                {
                    @* The end of the same sentence the top of the page started: what all of this is
                       for, and where the result will appear. Not a second refusal. *@
                    <span>@UiText.Accounts.EmptyUnconfigured</span>
                }
            </div>
        </div>
    }

    @foreach (var account in Model.Accounts)
    {
        <div class="card card--pad" style="max-width: 900px;">
            <div class="row" style="gap: 16px; align-items: flex-start;">
                <span class="brand-mark" aria-hidden="true">@account.Label</span>

                <span class="stack" style="gap: 4px; flex: 1; min-width: 0;">
                    <span class="mono" dir="ltr" style="font-size: 14px; font-weight: 700;">@account.Email</span>
                    @* The OAuth scope's short name, which is Google's own word in both languages. *@
                    <span class="mono muted" dir="ltr" style="font-size: 11px;">scope: drive</span>

                    @*
                        Which OAuth client connected this account. It is on the card because a
                        refresh token can only be presented by the client that issued it: with two
                        clients in the panel, this line is the difference between an account that can
                        be repaired and one that cannot — and it used to be written down nowhere.
                    *@
                    <span class="account-client @(account.ClientIsUsable ? null : "account-client--warn")">
                        @account.ClientText
                        @if (account.ClientId is { Length: > 0 } missing)
                        {
                            <span class="mono" dir="ltr">@missing</span>
                        }
                    </span>
                </span>

                <span class="badge @(account.Status == GoogleAccountStatus.Healthy ? null : "badge--warn")">
                    @account.StatusText
                </span>
            </div>

            @if (account.FailureReason is { Length: > 0 } reason)
            {
                @*
                    Why this account is unusable, for the one person who can fix it.

                    The customer is told «فضای ذخیره‌سازی در دسترس نیست» and that stays true for
                    them — Google's own error text can carry a resumable session URI or the address
                    of an operator account, and neither belongs in front of a tenant. But the
                    operator was being told nothing at all: Status said «قطع شده» and the reason
                    lived only in a log nobody on this box can read. Google's words, kept verbatim
                    and left LTR, because they are what an operator would search for.
                *@
                <div class="account-failure" role="status">
                    <span class="account-failure-head">
                        @(account.FailureAtText is { Length: > 0 } when
                            ? UiText.Accounts.LastFailureAt(when)
                            : UiText.Accounts.LastFailure)
                    </span>
                    <span class="account-failure-text mono" dir="ltr">@reason</span>
                </div>
            }

            <div style="margin-top: 14px; max-width: 320px;">
                <div class="bar-label">
                    <span>@UiText.Accounts.StorageUsed</span>
                    @* Latin in both languages, and dir="ltr" says so: two byte sizes an operator
                       compares against Google's own console, not a figure set in prose. *@
                    <span class="mono" dir="ltr">@account.UsedText / @account.TotalText</span>
                </div>
                @* The width is this account's own reading, not styling — it cannot live in a stylesheet. *@
                <div class="bar bar--lg"><span class="bar-fill" style="width: @(account.UsedPercent)%"></span></div>
            </div>

            <div class="row" style="gap: 8px; margin-top: 16px;">
                @*
                    «اتصال دوباره» first, and its own form rather than a second use of the one at the
                    top of the page. This is the action that names an account; the one above names
                    none, and Google is asked a different question for each — this one carries the
                    address as a login_hint so the chooser opens on it.

                    Same data-* contract as the connect form above, so the popup enhancement wires
                    every one of these without knowing how many cards there are. No status paragraph
                    inside it: three cards' worth of them would be three places for the same sentence
                    to appear, and the window it announces is the same window either way.
                *@
                <form method="post"
                      action="@Url.Action("Reconnect", "Accounts", new { id = account.Id })"
                      class="accounts-connect"
                      data-google-connect>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="popup" value="false" data-google-connect-popup />
                    <button type="submit"
                            class="btn btn--sm @(account.NeedsReconnect ? "btn--primary" : null)"
                            title="@UiText.Accounts.ReconnectHint"
                            aria-label="@UiText.Accounts.ReconnectAccount(account.Label)">@UiText.Accounts.Reconnect</button>
                </form>
                <form method="post" action="@Url.Action("RefreshQuota", "Accounts", new { id = account.Id })">
                    @Html.AntiForgeryToken()
                    @* aria-label on all three: with a pool the visible words repeat card for card, and
                       the label is the only thing that says which account a button belongs to. *@
                    <button type="submit"
                            class="btn btn--sm"
                            aria-label="@UiText.Accounts.RefreshQuotaAccount(account.Label)">@UiText.Accounts.RefreshQuota</button>
                </form>
                <form method="post" action="@Url.Action("Disconnect", "Accounts", new { id = account.Id })">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn--danger btn--sm"
                            aria-label="@UiText.Accounts.DisconnectAccount(account.Label)">@UiText.Accounts.Disconnect</button>
                </form>
            </div>
        </div>
    }
</div>

@*
    The pool as a table, under the cards.

    The cards say what Google reports about each account — a quota bar and a status. None of them
    says what is actually on the account, which is the one thing an operator needs before deciding
    to retire one: how many files, whose, and how much of somebody's data is about to move.

    Drawn only when there are accounts. On a fresh deployment the screen above is a single «connect
    an account» button, and a table of nothing under it would be furniture.
*@
@if (Model.Pool.Count > 0)
{
    <div class="card card--pad stack" style="gap: 12px;">
        <div>
            <h2 class="card-title">@UiText.Accounts.PoolHeading</h2>
            <p class="muted" style="font-size: 12px; line-height: 1.8; margin: 4px 0 0; max-width: 68ch;">
                @UiText.Accounts.PoolHint
            </p>
        </div>

        @* Six tracks: account · status · files · held · free · workspaces, then the drain form. *@
        <div class="dtable" style="--cols: minmax(160px,2fr) 96px 82px 96px 96px 104px;">
            <div class="dtable-head">
                <div>@UiText.Accounts.ColumnAccount</div>
                <div>@UiText.Accounts.ColumnStatus</div>
                <div class="cell-num">@UiText.Accounts.ColumnFiles</div>
                <div class="cell-num">@UiText.Accounts.ColumnHeld</div>
                <div class="cell-num">@UiText.Accounts.ColumnFree</div>
                <div class="cell-num">@UiText.Accounts.ColumnWorkspaces</div>
            </div>

            @foreach (var held in Model.Pool)
            {
                <div class="dtable-row">
                    <div class="cell-name" dir="auto" title="@held.Name">@held.Name</div>
                    <div class="cell-muted">@held.StatusText</div>
                    @* dir="ltr" on every figure, for the reason UploadPanel.vue spells out: an
                       RTL container reorders a run of digits beside a Latin unit. *@
                    <div class="cell-num" dir="ltr">@held.FilesText</div>
                    <div class="cell-num" dir="ltr">@held.HeldText</div>
                    <div class="cell-num" dir="ltr">@held.FreeText</div>
                    <div class="cell-num" dir="ltr">@held.TenantsText</div>
                </div>
            }
        </div>

        @*
            Moving everything off an account.

            One form per account with something on it, and none for an empty one — there is nothing
            to move and the control would be a button that does nothing. It is a <details> because
            it is a rare, consequential action that should not sit open beside five accounts, and
            the warning is inside it because the two things it does are not both obvious: the source
            gets paused, and each old copy is deleted six hours after its file has moved.
        *@
        @if (Model.DrainTargets.Count > 1)
        {
            foreach (var held in Model.Pool.Where(h => !h.IsEmpty && !h.IsDraining))
            {
                <details class="disclose">
                    <summary class="btn btn--sm">
                        @held.Name — @UiText.Accounts.MoveEverything
                    </summary>
                    <div class="disclose-body">
                        <form method="post"
                              class="stack"
                              style="gap: 8px;"
                              action="@Url.Action("Drain", "Accounts", new { id = held.Id })">
                            @Html.AntiForgeryToken()

                            <p class="muted" style="font-size: 11.5px; line-height: 1.8; margin: 0;">
                                @UiText.Accounts.DrainWarning
                            </p>

                            <label class="visually-hidden" for="drain-target-@held.Id">
                                @UiText.Accounts.MoveEverything
                            </label>
                            <select id="drain-target-@held.Id" name="target" class="control">
                                @foreach (var target in Model.DrainTargets.Where(t => t.Id != held.Id))
                                {
                                    <option value="@target.Id">@target.Name — @target.FreeText</option>
                                }
                            </select>

                            <button type="submit" class="btn btn--danger btn--block">
                                @UiText.Accounts.StartDrain
                            </button>
                        </form>
                    </div>
                </details>
            }
        }
    </div>
}

@if (Model.Drains.Count > 0)
{
    <div class="card card--pad stack" style="gap: 12px;">
        <h2 class="card-title">@UiText.Accounts.DrainsHeading</h2>

        @foreach (var drain in Model.Drains)
        {
            <div class="subcard stack" style="gap: 7px;">
                <div class="row" style="gap: 10px; flex-wrap: wrap;">
                    <span style="font-size: 12.5px; font-weight: 700;" dir="auto">
                        @drain.FromName → @drain.ToName
                    </span>
                    <span class="badge push-end">@drain.StatusText</span>
                </div>

                <div class="row mono muted" style="gap: 14px; font-size: 11px; flex-wrap: wrap;" dir="ltr">
                    <span>@drain.MovedText @UiText.Accounts.DrainMoved</span>
                    <span>@drain.RemainingText @UiText.Accounts.DrainRemaining</span>
                    <span>@drain.FailedText @UiText.Accounts.DrainFailed</span>
                    <span>@drain.StartedText</span>
                </div>

                @if (drain.FailureReason is { Length: > 0 } why)
                {
                    @* The operator's own error, verbatim. It names Drive and it names ids, and it
                       is on the one screen in the product no customer can reach. *@
                    <p class="muted" style="font-size: 11px; line-height: 1.7; margin: 0;" dir="auto">@why</p>
                }

                @if (drain.IsLive)
                {
                    <form method="post" action="@Url.Action("CancelDrain", "Accounts", new { id = drain.Id })">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn--sm">@UiText.Accounts.Cancel</button>
                    </form>
                }
            </div>
        }
    </div>
}
