@using DriveUnion.Core.Sharing
@using DriveUnion.Web.Models
@model PublicDownloadViewModel
@{
    var lang = Model.Language;

    Layout = "_PublicLayout";
    ViewData["Title"] = Model.FileName;

    // The layout builds the document's lang/dir and the FA/EN link from this. The controller
    // decided it from ?lang= and Accept-Language before any HTML existed, so the page is readable
    // with JavaScript off and cacheable per language.
    ViewData["Lang"] = PublicText.LangCode(lang);
}

<div class="public-card">
    @*
        The preview, or the stripes that stood in for one.

        Every element below points at /d/{slug}/preview and never at storage: a thumbnail served from
        googleusercontent.com would put the operator's account in the visitor's network log, which is
        the one thing this product may never do. Which of them is drawn was decided by `Previews`,
        server-side, against an allow-list — the view is told, it does not choose. `KindText` is the
        caption underneath because a preview that fails to load leaves a page with nothing on it.
    *@
    <div class="public-preview @(Model.Preview == PreviewKind.None ? "ph" : "public-preview--media")">
        @switch (Model.Preview)
        {
            case PreviewKind.Image:
                @*
                    alt is the file's own name: there is nothing else true to say about it.

                    No loading="lazy". This is the first thing on the card and it is the reason the
                    card looks like anything — deferring the one element the page exists to show is
                    what that attribute is for not doing.
                *@
                <img class="preview-image" src="@Model.PreviewUrl" alt="@Model.FileName" />
                break;

            case PreviewKind.Video:
                @* preload="metadata": enough for a first frame and a duration, not the whole film. *@
                <video class="preview-media" src="@Model.PreviewUrl" controls preload="metadata"
                       playsinline></video>
                break;

            case PreviewKind.Audio:
                <audio class="preview-media" src="@Model.PreviewUrl" controls preload="metadata"></audio>
                break;

            case PreviewKind.Document:
                @* title, because a frame without one is an unlabelled region to anything reading the page. *@
                <iframe class="preview-frame" src="@Model.PreviewUrl" title="@Model.FileName"></iframe>
                break;

            default:
                <span class="ph-label" dir="ltr">@Model.KindText</span>
                break;
        }
    </div>

    <div class="public-body">
        <span class="badge" style="margin-bottom: 12px;">
            @if (Model.SharedBy.Length > 0)
            {
                @* dir="auto": a workspace name is whatever its owner called it, in whichever script. *@
                @PublicText.Pick(lang, "به اشتراک گذاشته‌شده توسط", "Shared by") <span dir="auto">@Model.SharedBy</span>
            }
            else
            {
                @PublicText.Pick(lang, "فایل به اشتراک گذاشته‌شده", "Shared file")
            }
        </span>

        <h1 class="public-title">@Model.FileName</h1>

        @if (Model.Note is { Length: > 0 } note)
        {
            @*
                What the sender wrote. Interpolated, so Razor encodes it — this is the one string on
                this page that came from a person and is shown to a different person, and the whole
                point of it is that it says whatever they wanted it to.

                dir="auto" for the same reason the name has it, and white-space:pre-line so the line
                breaks somebody typed are the line breaks that are read.
            *@
            <p class="sender-note" dir="auto">@note</p>
        }

        <div class="meta-grid">
            <div class="meta-cell">
                <div class="meta-label">@PublicText.Pick(lang, "حجم", "Size")</div>
                <div class="meta-value mono" dir="ltr">@Model.SizeText</div>
            </div>
            <div class="meta-cell">
                <div class="meta-label">@PublicText.Pick(lang, "نوع", "Type")</div>
                <div class="meta-value mono" dir="ltr">@Model.KindText</div>
            </div>
            <div class="meta-cell">
                <div class="meta-label">@PublicText.Pick(lang, "تاریخ", "Date")</div>
                <div class="meta-value">@Model.DateText</div>
            </div>
            <div class="meta-cell">
                <div class="meta-label">@PublicText.Pick(lang, "اعتبار لینک", "Expires in")</div>
                <div class="meta-value">@Model.ExpiryText</div>
            </div>
        </div>

        @if (Model.EncryptionJson is { } header)
        {
            @*
                A locked file, and the button is deliberately not here.

                The bytes behind /d/{slug}/file are ciphertext, so an ordinary download link would
                hand the visitor a file of the right name and the right length that no program on
                their machine can open — the one failure that looks like success. What replaces it
                asks for the key and does the work in the tab.

                The fallback below is what a reader with no JavaScript sees, and it says so instead
                of offering the link anyway. There is nothing this server can do for them: it does
                not have the key and could not use it if it did.
            *@
            <div class="public-cta"
                 data-island="unlock-download"
                 data-header="@header"
                 data-download-url="@Model.DownloadUrl"
                 data-file-name="@Model.FileName"
                 data-lang="@PublicText.LangCode(lang)">
                <span class="public-assurance">
                    @PublicText.Pick(
                        lang,
                        "این فایل قفل است و برای باز شدن به جاوااسکریپت نیاز دارد.",
                        "This file is locked and needs JavaScript to be opened.")
                </span>
            </div>
        }
        else
        {
            <div class="public-cta">
                <a class="btn btn--primary btn--cta" href="@Model.DownloadUrl">
                    @PublicText.Pick(lang, "دانلود فایل", "Download file")
                </a>
                <span class="public-assurance">
                    @PublicText.Pick(
                        lang,
                        "دانلود مستقیم و استریم‌شده از سرور ما · بدون تبلیغ، بدون انتظار",
                        "Streamed directly from our server · no ads, no waiting")
                </span>
            </div>
        }
    </div>

    <div class="public-foot">
        <span class="mono" dir="ltr">@Model.DisplayUrl</span>
        <span>@Model.DownloadCountText</span>
    </div>
</div>
