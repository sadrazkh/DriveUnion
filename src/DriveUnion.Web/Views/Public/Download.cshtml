@using DriveUnion.Web.Models
@model PublicDownloadViewModel
@{
    var lang = Model.Language;

    Layout = "_PublicLayout";
    ViewData["Title"] = Model.FileName;

    // The layout builds the document's lang/dir and the FA/EN link from this. The controller
    // decided it from ?lang= and Accept-Language before any HTML existed, so the page is readable
    // with JavaScript off and cacheable per language.
    ViewData["Lang"] = PublicText.LangCode(lang);
}

<div class="public-card">
    <div class="ph public-preview">
        <span class="ph-label" dir="ltr">@Model.KindText</span>
    </div>

    <div class="public-body">
        <span class="badge" style="margin-bottom: 12px;">@PublicText.Pick(lang, "فایل به اشتراک گذاشته‌شده", "Shared file")</span>

        <h1 class="public-title">@Model.FileName</h1>

        <div class="meta-grid">
            <div class="meta-cell">
                <div class="meta-label">@PublicText.Pick(lang, "حجم", "Size")</div>
                <div class="meta-value mono" dir="ltr">@Model.SizeText</div>
            </div>
            <div class="meta-cell">
                <div class="meta-label">@PublicText.Pick(lang, "نوع", "Type")</div>
                <div class="meta-value mono" dir="ltr">@Model.KindText</div>
            </div>
            <div class="meta-cell">
                <div class="meta-label">@PublicText.Pick(lang, "تاریخ", "Date")</div>
                <div class="meta-value">@Model.DateText</div>
            </div>
            <div class="meta-cell">
                <div class="meta-label">@PublicText.Pick(lang, "اعتبار لینک", "Expires in")</div>
                <div class="meta-value">@Model.ExpiryText</div>
            </div>
        </div>

        @if (Model.EncryptionJson is { } header)
        {
            @*
                A locked file, and the button is deliberately not here.

                The bytes behind /d/{slug}/file are ciphertext, so an ordinary download link would
                hand the visitor a file of the right name and the right length that no program on
                their machine can open — the one failure that looks like success. What replaces it
                asks for the key and does the work in the tab.

                The fallback below is what a reader with no JavaScript sees, and it says so instead
                of offering the link anyway. There is nothing this server can do for them: it does
                not have the key and could not use it if it did.
            *@
            <div class="public-cta"
                 data-island="unlock-download"
                 data-header="@header"
                 data-download-url="@Model.DownloadUrl"
                 data-file-name="@Model.FileName"
                 data-lang="@PublicText.LangCode(lang)">
                <span class="public-assurance">
                    @PublicText.Pick(
                        lang,
                        "این فایل قفل است و برای باز شدن به جاوااسکریپت نیاز دارد.",
                        "This file is locked and needs JavaScript to be opened.")
                </span>
            </div>
        }
        else
        {
            <div class="public-cta">
                <a class="btn btn--primary btn--cta" href="@Model.DownloadUrl">
                    @PublicText.Pick(lang, "دانلود فایل", "Download file")
                </a>
                <span class="public-assurance">
                    @PublicText.Pick(
                        lang,
                        "دانلود مستقیم و استریم‌شده از سرور ما · بدون تبلیغ، بدون انتظار",
                        "Streamed directly from our server · no ads, no waiting")
                </span>
            </div>
        }
    </div>

    <div class="public-foot">
        <span class="mono" dir="ltr">@Model.DisplayUrl</span>
        <span>@Model.DownloadCountText</span>
    </div>
</div>
