@using DriveUnion.Web.Models
@model OperatorPlansPageViewModel
@{
    ViewData["Title"] = UiText.Plans.OperatorTitle;

    // Nine tracks. The table is its own scroll region (see .dtable), so the last two do not have to
    // be bought from the name column at a narrow width.
    const string PlanCols = "--cols: 104px minmax(var(--name-min),1fr) 92px 88px 108px 62px 80px 64px 148px";
    const string TenantCols = "--cols: minmax(0,1.6fr) 110px 150px 70px 90px";

    var message = TempData["PlansMessage"] as string;
    var error = TempData["PlansError"] as string;
}

<div class="stack" style="gap: 16px;">
    <div class="stack" style="gap: 4px;">
        <h1 class="page-title">@UiText.Plans.OperatorTitle</h1>
        <p class="page-sub">@UiText.Plans.OperatorSubtitle</p>
    </div>

    @* role="status" and role="alert" because these two sentences are the whole of what the screen
       says back after a write, and until they were their own element there was nothing to put the
       role on — an operator using a screen reader was told nothing had happened. *@
    @if (message is not null)
    {
        <p class="notice" role="status">@message</p>
    }

    @if (error is not null)
    {
        <p class="notice notice--danger" role="alert">@error</p>
    }

    @*
        The half of Plans:DefaultPlanCode that start-up deliberately does not check, because checking
        it needs a database and a panel that refuses to boot while the database is briefly away is
        the worse failure. Unsaid, the first person to learn the setting names nothing is a customer
        whose sign-up answers 500.
    *@
    @if (Model.DefaultMissingText is not null)
    {
        <div class="card">
            <div class="card-head">
                <div class="card-title danger">@UiText.PlanAdmin.DefaultMissingHeading</div>
            </div>
            <div class="card-body">
                <p style="font-size: 12.5px; margin: 0;">@Model.DefaultMissingText</p>
            </div>
        </div>
    }

    @*
        The figures below are the operator's own now — this screen writes them. What is still true is
        that the seeded ones were samples, so the warning stays until somebody has edited them.
    *@
    <div class="card">
        <div class="card-head">
            <div class="card-title warn">@UiText.Plans.PlaceholderHeading</div>
        </div>
        <div class="card-body">
            <p style="font-size: 12.5px; margin: 0;">@UiText.Plans.PlaceholderBody</p>
        </div>
    </div>

    <div class="card card--flush">
        <div class="card-head">
            <div class="card-title">@UiText.Plans.CatalogueHeading</div>
            <div class="row" style="gap: 12px; align-items: center;">
                <span class="muted" style="font-size: 11.5px;">@UiText.Plans.CatalogueNote</span>
                <a class="btn btn--sm btn--primary" href="@Url.Action("NewTier", "Plans")">@UiText.PlanAdmin.NewTier</a>
            </div>
        </div>

        <div class="dtable" style="@PlanCols">
            <div class="dtable-head">
                <div>@UiText.Plans.ColumnCode</div>
                <div>@UiText.Plans.ColumnName</div>
                <div>@UiText.Plans.ColumnStorage</div>
                <div>@UiText.Plans.ColumnFile</div>
                <div>@UiText.Plans.ColumnTraffic</div>
                <div>@UiText.Plans.ColumnSeats</div>
                <div>@UiText.Plans.ColumnStatus</div>
                <div>@UiText.PlanAdmin.ColumnWorkspaces</div>
                @* Pinned, with the cells under it: nine tracks is 850px and no operator's window makes
                   that a certainty, and the track that would go off the edge is the only one that
                   does anything. *@
                <div class="cell-pin">@UiText.PlanAdmin.ColumnActions</div>
            </div>

            @foreach (var plan in Model.Plans)
            {
                @*
                    A div rather than an anchor, unlike the workspace table below: the last cell holds
                    two posting forms, and a form inside an anchor is not markup a browser will keep.
                    The name is the link instead.
                *@
                <div class="dtable-row">
                    <div class="cell-slug" dir="ltr" data-label="@UiText.Plans.ColumnCode">@plan.Code</div>
                    <div class="cell-name">
                        <a href="@Url.Action("Tier", "Plans", new { code = plan.Code })" title="@plan.Name">@plan.Name</a>
                        @if (plan.IsConfiguredDefault)
                        {
                            <span class="badge badge--muted" title="@UiText.PlanAdmin.DefaultBadgeTitle">@UiText.PlanAdmin.DefaultBadge</span>
                        }
                    </div>
                    @* dir="ltr" on the three byte readouts and not on the fourth. «5 GB» is a number
                       and a Latin unit with a space between them: in an RTL cell the bidi algorithm
                       resolves that space to the paragraph's own direction and lays the two out as
                       «GB 5». The seat count is Persian numerals in Persian and needs no isolate. *@
                    <div class="cell-num" dir="ltr" data-label="@UiText.Plans.ColumnStorage">@plan.StorageText</div>
                    <div class="cell-num" dir="ltr" data-label="@UiText.Plans.ColumnFile">@plan.MaxFileText</div>
                    <div class="cell-num" dir="ltr" data-label="@UiText.Plans.ColumnTraffic">@plan.MonthlyTrafficText</div>
                    <div class="cell-num" data-label="@UiText.Plans.ColumnSeats">@plan.SeatsText</div>
                    <div class="@(plan.IsRetired ? "cell-muted" : null)"
                         data-label="@UiText.Plans.ColumnStatus">@plan.StatusText</div>
                    @* How many workspaces carry this tier — the size of a re-apply, never the size of
                       an edit. Editing the row above moves none of them. *@
                    <div class="cell-num" data-label="@UiText.PlanAdmin.ColumnWorkspaces">@plan.WorkspacesText</div>
                    <div class="row cell-pin" style="gap: 4px; align-items: center;">
                        @*
                            Named rather than left to the tier name being a link. Retire, delete and
                            re-apply live on the tier's own page instead of here, because each of
                            them needs the sentence beside it more than it needs to be one click
                            closer — and a form cannot be nested in the row anchor the table below uses.
                        *@
                        <a class="btn btn--sm" href="@Url.Action("Tier", "Plans", new { code = plan.Code })">@UiText.PlanAdmin.Edit</a>
                        @* The glyphs are not text and have no language; the label a screen reader
                           reads does, and comes from the catalogue like everything else. *@
                        <form method="post" action="@Url.Action("Move", "Plans", new { code = plan.Code })">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Direction" value="Up" />
                            <button type="submit" class="btn btn--sm" title="@UiText.PlanAdmin.MoveUp"
                                    aria-label="@UiText.PlanAdmin.MoveUp">&#8593;</button>
                        </form>
                        <form method="post" action="@Url.Action("Move", "Plans", new { code = plan.Code })">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Direction" value="Down" />
                            <button type="submit" class="btn btn--sm" title="@UiText.PlanAdmin.MoveDown"
                                    aria-label="@UiText.PlanAdmin.MoveDown">&#8595;</button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div class="card-foot">
            @* Retire is the verb, and the screen says why here rather than in a refusal after the
               operator has already pressed something else. *@
            <span class="hint">@UiText.PlanAdmin.RetireRatherThanDelete</span>
        </div>
    </div>

    <div class="card card--flush">
        <div class="card-head">
            <div class="card-title">@UiText.Plans.TenantsHeading</div>
            @*
                Over-commitment is shown rather than prevented: a cap is a per-customer ceiling, not
                a reservation, and requiring the sum to fit the pool would make every new workspace
                wait on a capacity purchase.

                No dir="ltr" and no .mono, both of which this line used to carry. «تعهدشده: ۱۴ TB از
                ۱۰ TB» is a Persian sentence with two Latin quantities set into it, and an LTR
                isolate around the whole of it lays the sentence out left to right — the label ends
                up on the wrong side and the reader starts at the last word. Left in the document's
                direction the sentence reads correctly; what is still wrong is inside the two
                quantities, and that can only be fixed where the sentence is assembled.
            *@
            <span class="@(Model.IsOverCommitted ? "warn" : null)" style="font-size: 11.5px;">@Model.CommittedText</span>
        </div>

        <div class="dtable" style="@TenantCols">
            <div class="dtable-head">
                <div>@UiText.Plans.ColumnTenant</div>
                <div>@UiText.Plans.ColumnPlan</div>
                <div>@UiText.Plans.ColumnUsed</div>
                <div>@UiText.Plans.ColumnFiles</div>
                <div>@UiText.Plans.ColumnSeats</div>
            </div>

            @if (Model.Tenants.Count == 0)
            {
                <div class="empty empty--incell">
                    <span>@UiText.Plans.NoTenants</span>
                </div>
            }
            else
            {
                @foreach (var tenant in Model.Tenants)
                {
                    <a class="dtable-row" href="@Url.Action("OperatorTenant", "Plans", new { tenantId = tenant.TenantId })">
                        <div class="cell-name" title="@tenant.Name">@tenant.Name</div>
                        <div class="cell-slug" dir="ltr" data-label="@UiText.Plans.ColumnPlan">@tenant.PlanText</div>
                        <div class="stack" style="gap: 4px;" data-label="@UiText.Plans.ColumnUsed">
                            <span class="mono" dir="ltr" style="font-size: 12px;">@tenant.UsedText</span>
                            <div class="bar">
                                <div class="@tenant.FillClass" style="width: @tenant.Percent.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                            </div>
                        </div>
                        <div class="cell-num" data-label="@UiText.Plans.ColumnFiles">@tenant.FilesText</div>
                        <div data-label="@UiText.Plans.ColumnSeats">@tenant.MembersText</div>
                    </a>
                }
            }
        </div>

        <div class="card-foot">
            <div class="stack" style="gap: 4px;">
                @if (Model.IsOverCommitted)
                {
                    <span class="warn" style="font-size: 12px;">@UiText.Plans.OverCommittedNote</span>
                }
                @*
                    Traffic gets no pool comparison, and the screen says why rather than leaving a
                    reader hunting for the second number: the box's egress ceiling is a bandwidth
                    figure and nobody has measured it yet.

                    A sentence, not a readout — see «تعهدشده» above for why it is neither monospace
                    nor an LTR isolate.
                *@
                <span style="font-size: 11.5px;">@Model.SoldTrafficText</span>
                <span class="hint">@UiText.Plans.SoldTrafficNote</span>
            </div>
        </div>
    </div>
</div>
