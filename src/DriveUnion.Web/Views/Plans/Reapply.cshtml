@using DriveUnion.Web.Models
@model ReapplyPlanPageViewModel
@{
    ViewData["Title"] = Model.Title;

    var error = TempData["PlansError"] as string;
}

@*
    The one catalogue action that reaches customers, and the only screen in this slice that asks for
    a confirmation. It is its own page rather than a button on the tier form because it does the
    opposite of what that form does: saving the tier moves nobody, and this moves everybody on it —
    including a customer carrying a ceiling somebody negotiated for them.
*@
<div class="stack" style="gap: 16px;">
    <div class="page-head">
        <h1 class="page-title">@Model.Title</h1>
        <a class="page-sub" href="@Url.Action("Tier", "Plans", new { code = Model.Code })">@UiText.Plans.BackToPlans</a>
    </div>

    @if (error is not null)
    {
        <p class="notice notice--danger" role="alert">@error</p>
    }

    <div class="card">
        <div class="card-head">
            <div class="card-title">@UiText.Plans.PreviewHeading</div>
        </div>

        <div class="card-body">
            <div class="stack" style="gap: 12px;">
                @* What every workspace on the tier ends up holding. *@
                <div class="meta-grid">
                    <div class="meta-cell">
                        <div class="meta-label">@UiText.Plans.ColumnStorage</div>
                        <div class="meta-value mono" dir="ltr">@Model.StorageText</div>
                    </div>
                    <div class="meta-cell">
                        <div class="meta-label">@UiText.Plans.ColumnFile</div>
                        <div class="meta-value mono" dir="ltr">@Model.MaxFileText</div>
                    </div>
                    <div class="meta-cell">
                        <div class="meta-label">@UiText.Plans.ColumnTraffic</div>
                        <div class="meta-value mono" dir="ltr">@Model.MonthlyTrafficText</div>
                    </div>
                    <div class="meta-cell">
                        <div class="meta-label">@UiText.Plans.ColumnSeats</div>
                        <div class="meta-value">@Model.SeatsText</div>
                    </div>
                </div>

                <span style="font-size: 12.5px;">@Model.CountsText</span>

                @* The expensive mistake this button can make, said before it is pressed. *@
                <span class="warn" style="font-size: 12.5px;">@UiText.PlanAdmin.ReapplyTakesBackOverrides</span>

                <span class="hint">@UiText.PlanAdmin.ReapplyIsAudited</span>

                @* A downgrade constrains the next action, never an existing one — the same line the
                   per-workspace screen shows, because this is the same write done in a loop. *@
                <span class="hint">@UiText.Plans.PreviewRule</span>
            </div>
        </div>

        @if (Model.WorkspacesOnPlan > 0)
        {
            <div class="card-foot">
                <form method="post" action="@Url.Action("ReapplyConfirmed", "Plans", new { code = Model.Code })"
                      class="row" style="gap: 8px; align-items: flex-end; flex-wrap: wrap; width: 100%;">
                    @Html.AntiForgeryToken()

                    <div class="form-field" style="flex: 1 1 260px;">
                        <label class="field-label" for="reapply-reason">@UiText.Plans.AssignReasonField</label>
                        <input id="reapply-reason" name="Reason" class="control" required maxlength="512" />
                    </div>

                    <button type="submit" class="btn btn--primary">@UiText.PlanAdmin.ReapplyConfirm</button>
                </form>
            </div>
        }
    </div>

    <span class="hint">@UiText.Plans.AssignReasonHint</span>
</div>
