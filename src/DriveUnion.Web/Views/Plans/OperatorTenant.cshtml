@using DriveUnion.Web.Models
@model OperatorTenantPlanPageViewModel
@{
    ViewData["Title"] = UiText.Plans.TenantHeading(Model.TenantName);

    const string HistoryCols = "--cols: 140px 130px 110px 110px minmax(0,1fr)";

    var message = TempData["PlansMessage"] as string;
    var error = TempData["PlansError"] as string;
}

<div class="stack" style="gap: 16px;">
    <div class="row" style="align-items: baseline; gap: 12px;">
        <h1 class="page-title">@UiText.Plans.TenantHeading(Model.TenantName)</h1>
        <a class="page-sub" href="@Url.Action("Operator", "Plans")">@UiText.Plans.BackToPlans</a>
    </div>

    @if (message is not null)
    {
        <div class="card"><div class="card-body"><span style="font-size: 12.5px;">@message</span></div></div>
    }

    @if (error is not null)
    {
        <div class="card">
            <div class="card-body"><span style="font-size: 12.5px; color: var(--danger);">@error</span></div>
        </div>
    }

    @* What this workspace's numbers are right now. They are on its own row, copied from a tier that
       may since have been edited or retired — which is why this reads the workspace and not a plan. *@
    <div class="card">
        <div class="card-head">
            <div class="card-title">@UiText.Plans.PlanLabel — @Model.PlanName</div>
        </div>
        <div class="card-body">
            <div class="meta-grid">
                <div class="meta-cell">
                    <div class="meta-label">@UiText.Plans.StorageLabel</div>
                    <div class="meta-value mono" dir="ltr">@Model.StorageText</div>
                </div>
                <div class="meta-cell">
                    <div class="meta-label">@UiText.Plans.FileLabel</div>
                    <div class="meta-value mono" dir="ltr">@Model.MaxFileText</div>
                </div>
                <div class="meta-cell">
                    <div class="meta-label">@UiText.Plans.TrafficLabel</div>
                    <div class="meta-value mono" dir="ltr">@Model.MonthlyTrafficText</div>
                </div>
                <div class="meta-cell">
                    <div class="meta-label">@UiText.Plans.MembersLabel</div>
                    <div class="meta-value">@Model.MembersText</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <div class="card-title">@UiText.Plans.AssignHeading</div>
        </div>

        <div class="card-body">
            <div class="stack" style="gap: 12px;">
                @*
                    The preview is a GET, so an operator can look at what a tier would do as often as
                    they like without writing anything. Only the second form writes.
                *@
                <form method="get" class="row" style="gap: 8px; align-items: flex-end; flex-wrap: wrap;">
                    <div class="field">
                        <label class="field-label" for="preview-plan">@UiText.Plans.AssignPlanField</label>
                        <select id="preview-plan" name="plan"
                                style="border: 1px solid var(--line); border-radius: 9px; font-size: 12.5px; padding: 7px 10px;">
                            @foreach (var plan in Model.Assignable)
                            {
                                <option value="@plan.Code" selected="@(plan.Code == Model.SelectedPlanCode)">@plan.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn">@UiText.Plans.Preview</button>
                </form>

                @if (Model.Preview is { } preview)
                {
                    <div class="card card--pad">
                        <div class="stack" style="gap: 8px;">
                            <div class="card-title">@preview.PlanNameText</div>

                            <div class="meta-grid">
                                <div class="meta-cell">
                                    <div class="meta-label">@UiText.Plans.ColumnStorage</div>
                                    <div class="meta-value mono" dir="ltr">@preview.ProposedStorageText</div>
                                </div>
                                <div class="meta-cell">
                                    <div class="meta-label">@UiText.Plans.ColumnFile</div>
                                    <div class="meta-value mono" dir="ltr">@preview.ProposedFileText</div>
                                </div>
                                <div class="meta-cell">
                                    <div class="meta-label">@UiText.Plans.ColumnTraffic</div>
                                    <div class="meta-value mono" dir="ltr">@preview.ProposedTrafficText</div>
                                </div>
                                <div class="meta-cell">
                                    <div class="meta-label">@UiText.Plans.ColumnSeats</div>
                                    <div class="meta-value">@preview.ProposedSeatsText</div>
                                </div>
                            </div>

                            @if (preview.Fits)
                            {
                                <span style="font-size: 12.5px;">@UiText.Plans.PreviewFits</span>
                            }
                            else
                            {
                                @if (preview.StorageOverageText is not null)
                                {
                                    <span style="font-size: 12.5px; color: var(--warn);">@preview.StorageOverageText</span>
                                }
                                @if (preview.FilesOverText is not null)
                                {
                                    <span style="font-size: 12.5px;">@preview.FilesOverText</span>
                                }
                                @if (preview.MembersOverText is not null)
                                {
                                    <span style="font-size: 12.5px;">@preview.MembersOverText</span>
                                }
                            }

                            @* The one line that covers all four dimensions, said before the operator
                               confirms rather than after the customer notices. *@
                            <span class="muted" style="font-size: 12px;">@UiText.Plans.PreviewRule</span>
                        </div>
                    </div>
                }

                <form method="post" action="@Url.Action("Apply", "Plans", new { tenantId = Model.TenantId })"
                      class="row" style="gap: 8px; align-items: flex-end; flex-wrap: wrap;">
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <label class="field-label" for="apply-plan">@UiText.Plans.AssignPlanField</label>
                        <select id="apply-plan" name="PlanCode"
                                style="border: 1px solid var(--line); border-radius: 9px; font-size: 12.5px; padding: 7px 10px;">
                            @foreach (var plan in Model.Assignable)
                            {
                                <option value="@plan.Code" selected="@(plan.Code == Model.SelectedPlanCode)">@plan.Name</option>
                            }
                        </select>
                    </div>

                    <div class="field" style="flex: 1 1 260px;">
                        <label class="field-label" for="apply-reason">@UiText.Plans.AssignReasonField</label>
                        <input id="apply-reason" name="Reason" required maxlength="512"
                               style="border: 1px solid var(--line); border-radius: 9px; font-size: 12.5px; padding: 7px 10px; width: 100%;" />
                    </div>

                    <button type="submit" class="btn btn--primary">@UiText.Plans.Apply</button>
                </form>

                <span class="muted" style="font-size: 12px;">@UiText.Plans.AssignReasonHint</span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <div class="card-title">@UiText.Plans.OverrideHeading</div>
            <span class="muted" style="font-size: 11.5px;">@UiText.Plans.OverrideNote</span>
        </div>

        <div class="card-body">
            <form method="post" action="@Url.Action("Override", "Plans", new { tenantId = Model.TenantId })"
                  class="row" style="gap: 8px; align-items: flex-end; flex-wrap: wrap;">
                @Html.AntiForgeryToken()

                <div class="field">
                    <label class="field-label" for="override-field">@UiText.Plans.OverrideField</label>
                    <select id="override-field" name="Field"
                            style="border: 1px solid var(--line); border-radius: 9px; font-size: 12.5px; padding: 7px 10px;">
                        @foreach (var (field, label) in Model.Fields)
                        {
                            <option value="@field">@label</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label class="field-label" for="override-value">@UiText.Plans.OverrideValue</label>
                    <input id="override-value" name="Value" type="number" min="0" step="1" required dir="ltr"
                           style="border: 1px solid var(--line); border-radius: 9px; font-size: 12.5px; padding: 7px 10px;" />
                </div>

                <div class="field" style="flex: 1 1 260px;">
                    <label class="field-label" for="override-reason">@UiText.Plans.AssignReasonField</label>
                    <input id="override-reason" name="Reason" required maxlength="512"
                           style="border: 1px solid var(--line); border-radius: 9px; font-size: 12.5px; padding: 7px 10px; width: 100%;" />
                </div>

                <button type="submit" class="btn">@UiText.Plans.Apply</button>
            </form>

            <span class="muted" style="font-size: 12px;">@UiText.Plans.OverrideValueHint</span>
        </div>
    </div>

    @*
        One workspace's history on one workspace's page. This is not the general audit log M5 §12
        declined and must not grow into one: a quota is a commercial promise, and «چرا سهمیه‌ام عوض
        شد» has to be answerable without a support engineer writing SQL.
    *@
    <div class="card card--flush">
        <div class="card-head">
            <div class="card-title">@UiText.Plans.HistoryHeading</div>
            <span class="muted" style="font-size: 11.5px;">@UiText.Plans.HistoryNote</span>
        </div>

        <div class="dtable" style="@HistoryCols">
            <div class="dtable-head">
                <div>@UiText.Plans.ColumnWhen</div>
                <div>@UiText.Plans.ColumnField</div>
                <div>@UiText.Plans.ColumnFrom</div>
                <div>@UiText.Plans.ColumnTo</div>
                <div>@UiText.Plans.ColumnReason</div>
            </div>

            @if (Model.History.Count == 0)
            {
                <div class="empty empty--incell">
                    <span>@UiText.Plans.HistoryEmpty</span>
                </div>
            }
            else
            {
                @foreach (var row in Model.History)
                {
                    <div class="dtable-row">
                        <div style="font-size: 12px;">@row.WhenText</div>
                        <div style="font-size: 12px;">@row.FieldText</div>
                        <div class="cell-num">@row.FromText</div>
                        <div class="cell-num">@row.ToText</div>
                        <div class="cell-muted" title="@row.Reason">@row.Reason</div>
                    </div>
                }
            }
        </div>
    </div>
</div>
