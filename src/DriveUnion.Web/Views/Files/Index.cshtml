@using DriveUnion.Core.Sharing
@using DriveUnion.Web.Models
@model FilesPageViewModel
@{
    ViewData["Title"] = UiText.Files.Title;

    // The comp's tracks minus «اکانت» and «دانلود»: a customer must never learn which Google
    // account holds their file, and FileListItem carries a link count rather than a download
    // total. Checkbox · name · size · modified · links.
    //
    // The name track's floor is --name-min from app.css rather than the comp's 0: 348px of fixed
    // track does not fit a 375px phone, and minmax(0,…) answers that by drawing no name at all.
    const string Cols = "--cols: 28px minmax(var(--name-min),2.4fr) 92px 110px 118px";
}
@{
    // The last column, and the only thing that changes between browsing and searching.
    //
    // A search result's most useful fifth column is where it was found; a browsed row's is how many
    // links it has. Swapped rather than added, so the tracks are the same five whichever state the
    // screen is in — a table that changes shape when a reader types is a table that moves under
    // them, and the fixed tracks are already 348px against a 341px phone.
    // IsFiltered and not IsSearching: filtering by a label is workspace-wide too, so those rows
    // carry a folder path in that cell as well. Keyed off the narrower question, the header said
    // «لینک» over a column of folder names.
    var lastColumn = Model.IsFiltered ? UiText.Files.ColumnFolder : UiText.Files.ColumnLinks;
}

@*
    Server-rendered whole. The antiforgery pair below is how an island's fetch satisfies the write
    APIs — the panel is cookie-authenticated, so every state-changing call carries this header.
*@
<div class="stack"
     style="gap: 16px;"
     data-panel="files"
     data-antiforgery-header="@Model.Antiforgery.HeaderName"
     data-antiforgery-token="@Model.Antiforgery.Token">

    <div class="page-head">
        <h1 class="page-title">@UiText.Files.Title</h1>
        @* While a search is on, the count beside the heading is the count of what matched — «۱ فایل»
           over a filtered table is a sentence about the workspace that happens to be false. *@
        <span class="page-sub">
            @(Model.IsSearching
                ? UiText.Files.SearchCount(Model.Rows.Count, Model.Query!)
                : UiText.Files.FileCount(Model.Rows.Count))
        </span>
        @if (Model.IsSearching)
        {
            <a class="btn btn--sm" href="@Url.Action("Index", "Files")">@UiText.Files.ClearSearch</a>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <p class="page-sub" role="status">@Model.Notice</p>
    }

    @*
        A clean-up still running, and nearly always nothing at all.

        It is not a progress bar in front of something the reader is waiting for: the files they
        deleted are already out of the table and already in the trash. It is here so that a workspace
        whose trash is still filling up half a minute after the press is a workspace that was told,
        rather than one that noticed. `role="status"` for the same reason the notice above has one —
        it appears without the reader doing anything.
    *@
    @foreach (var tidying in Model.Tidying)
    {
        <p class="page-sub" role="status">@tidying.Text</p>
    }

    @*
        Files being locked, and files whose locking went wrong.

        Nearly always nothing. It is on this screen because this is the screen the lock was pressed
        on, and unlike the clean-ups above it is not only reassurance: a lock is a file quietly
        becoming unreadable over the next few minutes, and a customer who does not see it happening
        is one who opens the file later, meets a passphrase prompt, and has to work out why.

        Completed locks are deliberately absent. The padlock in the table is the durable record; this
        is the transient one, and a year of «locked» rows would bury the one that is still running.
    *@
    @foreach (var job in Model.Locking)
    {
        <div class="subcard stack" style="gap: 6px;" role="status">
            <div class="row" style="gap: 10px; flex-wrap: wrap;">
                <span style="font-size: 12.5px; font-weight: 600;" dir="auto">🔒 @job.Name</span>
                <span class="badge @(job.IsLive ? null : "badge--warn") push-end">@job.StatusText</span>
            </div>

            @if (job.IsLive)
            {
                <span class="mono muted" dir="ltr" style="font-size: 11px;">@job.ProgressText</span>
            }

            @if (job.FailureReason is { Length: > 0 } why)
            {
                <p class="muted" style="font-size: 11px; line-height: 1.7; margin: 0;" dir="auto">@why</p>
            }
        </div>
    }

    @*
        The toolbar: where you are on one side, what you can do to it on the other.

        Drawn only while browsing. A search is the whole workspace — it is not standing anywhere, so
        a breadcrumb would be pointing at a place the results are not from, and «حذف این پوشه» would
        name whichever folder the reader happened to be in before they typed.

        A folder is managed from inside it rather than from a control on its own row: a row here is
        an anchor that opens the folder, and an anchor cannot hold the three forms this needs.
    *@
    @if (!Model.IsFiltered)
    {
        <div class="row" style="gap: 12px; flex-wrap: wrap; align-items: center;">
            <nav class="crumbs" aria-label="@UiText.Files.RootFolder">
                @foreach (var crumb in Model.Breadcrumb)
                {
                    if (!crumb.IsCurrent)
                    {
                        <a href="@Url.Action("Index", "Files", new { folder = crumb.Id })"
                           data-drop-folder="@crumb.Id">@crumb.Name</a>
                        <span class="crumb-sep" aria-hidden="true">/</span>
                    }
                    else
                    {
                        <span class="crumb-here" aria-current="page">@crumb.Name</span>
                    }
                }
            </nav>

            <span class="row push-end" style="gap: 8px; flex-wrap: wrap;">
                <details class="disclose">
                    <summary class="btn btn--sm">@UiText.Files.NewFolder</summary>
                    <div class="disclose-body">
                        <form method="post" class="stack" style="gap: 8px;"
                              action="@Url.Action("CreateFolder", "Files", new { folder = Model.Folder })">
                            @Html.AntiForgeryToken()
                            <label class="visually-hidden" for="new-folder-name">@UiText.Files.FolderName</label>
                            <input id="new-folder-name" name="name" class="control" required maxlength="512"
                                   dir="auto" autocomplete="off" placeholder="@UiText.Files.FolderName" />
                            <button type="submit" class="btn btn--primary btn--block">@UiText.Files.NewFolder</button>
                        </form>
                    </div>
                </details>

                @if (Model.Folder is { } current)
                {
                    var currentName = Model.Breadcrumb.LastOrDefault()?.Name ?? string.Empty;
                    var above = Model.Breadcrumb.Count > 1 ? Model.Breadcrumb[^2].Id : null;

                    @*
                        One menu, not three buttons.

                        Rename, move and delete are the three things you can do to the folder you are
                        standing in, and each of them was its own control in the toolbar — four
                        controls across the top of a screen whose job is to show a list. They are one
                        «این پوشه» now, and what is inside it is the same three forms.
                    *@
                    <details class="disclose">
                        <summary class="btn btn--sm">@UiText.Files.ThisFolder</summary>
                        <div class="disclose-body">
                            <div class="stack" style="gap: 12px;">
                                <form method="post" class="stack" style="gap: 6px;"
                                      action="@Url.Action("RenameFolder", "Files", new { id = current, folder = current })">
                                    @Html.AntiForgeryToken()
                                    <label class="hint" for="rename-folder">@UiText.Files.Rename</label>
                                    <input id="rename-folder" name="name" class="control" required maxlength="512"
                                           dir="auto" autocomplete="off" value="@currentName" />
                                    <button type="submit" class="btn btn--block">@UiText.Files.Rename</button>
                                </form>

                                @* The destination list leaves out this folder and everything under
                                   it, which is the one move that is always refused. Built by its own
                                   walk rather than by filtering the file list: dropping one entry
                                   would leave its children in. *@
                                <form method="post" class="stack" style="gap: 6px;"
                                      action="@Url.Action("MoveFolder", "Files", new { id = current, folder = current })">
                                    @Html.AntiForgeryToken()
                                    <label class="hint" for="move-folder">@UiText.Files.MoveTo</label>
                                    <select id="move-folder" name="destination" class="control">
                                        @foreach (var choice in Model.FolderMoveTargets)
                                        {
                                            <option value="@choice.Id">@choice.Label</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn--block">@UiText.Files.Move</button>
                                </form>

                                @*
                                    One delete button, and which one it is depends on what is in the
                                    folder.

                                    Empty: the plain one, which destroys a name. It refuses anything
                                    with something live in it, so there is nothing to confirm.

                                    Not empty: the recursive one, whose label is the confirmation.
                                    Drawing both would put the refusing one next to the one that
                                    works, and a reader who pressed the wrong of two buttons called
                                    «حذف» would either be told no for no visible reason or delete
                                    four hundred files they were only clearing a name off.

                                    What it destroys goes to the trash and comes back for the whole
                                    retention window, which is why the label is the ceremony rather
                                    than a dialogue in front of an undo.
                                *@
                                @if (Model.IsEmpty)
                                {
                                    <form method="post"
                                          action="@Url.Action("DeleteFolder", "Files", new { id = current, folder = above })">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn--danger btn--block">@UiText.Files.Delete</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post"
                                          action="@Url.Action("DeleteFolderAndContents", "Files", new { id = current, folder = above })">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn--danger btn--block">
                                            @UiText.Files.DeleteFolderAndContents
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </details>
                }
            </span>
        </div>
    }

    @*
        The workspace's labels, as a row of filters.

        A tag is only worth having if pressing it shows you what carries it, so the list is the
        control rather than a legend beside one. Drawn whenever the workspace has any — including
        while a search is on, because narrowing a search by label is the pair of them doing what
        neither does alone.
    *@
    @if (Model.Labels.Count > 0)
    {
        <div class="row" style="gap: 6px; flex-wrap: wrap; align-items: center;">
            @foreach (var label in Model.Labels)
            {
                var isOn = label.Id == Model.Tag;

                <a class="badge @(isOn ? "badge--count" : "badge--muted")"
                   href="@Url.Action("Index", "Files", new { q = Model.Query, tag = isOn ? (Guid?)null : label.Id })"
                   title="@UiText.Files.TagCount(label.FileCount, label.Name)">@label.Name</a>
            }

            @if (Model.ActiveTag is { } active)
            {
                <form method="post" class="row" style="gap: 6px;"
                      action="@Url.Action("DeleteTag", "Files", new { id = active.Id, folder = Model.Folder })">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn--sm btn--danger" title="@UiText.Files.RemoveLabel">
                        @UiText.Files.RemoveLabel
                    </button>
                </form>
            }
        </div>
    }

    @*
        One form around the whole table.

        The checkboxes are the selection and the button that is pressed is the verb, so «انتقال»,
        «برچسب» and «حذف» share one list of ids. Three forms would be three copies of that list, or
        a script keeping them in step — and this screen works without one.

        It is `data-file-grid` as well, which is where the drag-and-drop enhancement attaches. That
        is an enhancement in the strict sense: everything below already works by pressing things.
    *@
    <div class="split">
        <div class="card card--flush">
            <form method="post" data-file-grid data-island="file-grid"
                  action="@Url.Action("Selection", "Files", new { q = Model.Query, folder = Model.Folder, tag = Model.Tag })">
            @Html.AntiForgeryToken()
            <div class="dtable" style="@Cols">
                <div class="dtable-head">
                    @* The header checkbox is a script-only convenience: with JavaScript off there is
                       nothing for it to do, so it is not drawn at all rather than drawn dead. *@
                    <div><span data-select-all hidden></span></div>
                    <div>@UiText.Files.ColumnName</div>
                    <div>@UiText.Files.ColumnSize</div>
                    <div>@UiText.Files.ColumnModified</div>
                    <div>@lastColumn</div>
                </div>

                @* Folders first, and above the files rather than mixed in with them: a reader
                   scanning for somewhere to go should not have to read past twenty file names to
                   find it. Each is an anchor that opens it — everything you can do *to* a folder is
                   in the toolbar once you are inside, and `data-drop-folder` makes it a place files
                   can be dragged onto. *@
                @foreach (var folder in Model.FolderRows)
                {
                    <a class="dtable-row" href="@Url.Action("Index", "Files", new { folder = folder.Id })"
                       title="@UiText.Files.Open" data-drop-folder="@folder.Id">
                        @* .cell-tick is the marker track: a ▸ here and a checkbox on a file's row.
                           Below 640px the table is a stack of records and this is what sits in the
                           corner of one — see app.css. *@
                        <div class="cell-tick"><span class="muted" aria-hidden="true">▸</span></div>
                        <div class="cell-name" title="@folder.Name">@folder.Name</div>
                        @* The contents count sits under «حجم», because it is the answer to the same
                           question a size answers — how much is in there. A folder has no size, and
                           adding up its subtree on every row of every listing would be a walk of the
                           whole catalogue to draw one column. *@
                        <div class="cell-muted" data-label="@UiText.Files.ColumnSize">@folder.ContentsText</div>
                        @* Two cells a folder has nothing to put in. They fill the track here and are
                           dropped from the phone's record, where each would be a labelled line whose
                           value is a dash. *@
                        <div class="cell-muted cell-empty">—</div>
                        <div class="cell-muted cell-empty">—</div>
                    </a>
                }

                @if (Model.Rows.Count == 0 && Model.IsFiltered)
                {
                    @* Two different emptinesses, and telling them apart is most of what makes a
                       search trustworthy: an account with nothing in it, and a term that matched
                       nothing in an account that is full. The action is the way back to the list,
                       not «upload the first file» — the reader has files, just not this one.
                       A label that carries nothing is the same shape and gets the same answer. *@
                    <div class="empty empty--incell">
                        <span>
                            @(Model.IsSearching
                                ? UiText.Files.NoMatchHeading(Model.Query!)
                                : UiText.Files.NoTagMatchHeading(Model.ActiveTag?.Name ?? string.Empty))
                        </span>
                        @if (Model.IsSearching)
                        {
                            <span>@UiText.Files.NoMatchBody</span>
                        }
                        <a class="btn btn--primary" href="@Url.Action("Index", "Files")">@UiText.Files.ClearSearch</a>
                    </div>
                }
                else if (Model.IsEmpty)
                {
                    @* Three emptinesses now, and the third is a folder somebody just made. «هنوز
                       فایلی آپلود نشده» inside it would be a sentence about the workspace, and the
                       workspace is not empty — they have files, just not here. *@
                    <div class="empty empty--incell">
                        <span>
                            @(Model.Folder is null
                                ? UiText.Files.EmptyStateHeading
                                : UiText.Files.FolderEmptyStateHeading)
                        </span>
                        <a class="btn btn--primary" href="@Url.Action("Upload", "Files")">@UiText.Files.EmptyStateAction</a>
                    </div>
                }
                else
                {
                    @*
                        A file row is no longer an anchor, and that is what multi-select cost.

                        A real <input type="checkbox"> inside an <a> is a control whose every click
                        navigates instead of ticking; the row that was a link had a .rowbox that
                        looked like a checkbox and was a <span>. So the row is a box and the name is
                        the link — the cell you read is the cell you press to open it — and the
                        checkbox in the first column is a checkbox. `draggable` and `data-file` are
                        for the enhancement; neither is needed for any of this to work.
                    *@
                    foreach (var row in Model.Rows)
                    {
                        <div class="dtable-row @(row.IsSelected ? "is-selected" : null)"
                             draggable="true" data-file="@row.Id" data-file-name="@row.Name">
                            @*
                                The cell is the <label>, and that is what makes the tick pressable on
                                a phone. A checkbox is 13px in this panel and 22px below 640px, and
                                neither is a target: there is no text beside it for a label to have
                                been wrapped round, so without this the only thing to aim at is the
                                control itself. As a label the whole 44px corner of the record passes
                                the press on. `for` is deliberately absent — a label containing its
                                control needs none, and the input already carries the name.
                            *@
                            <label class="cell-tick">
                                <input type="checkbox" name="ids" value="@row.Id" class="rowcheck"
                                       aria-label="@UiText.Files.SelectThisFile(row.Name)" />
                            </label>
                            <div class="cell-name" title="@row.Name">
                                @* The term and the folder ride along, or opening a result is what
                                   ends the search that found it. *@
                                @*
                                    To the file's own page, not back to this list with a panel open.
                                    The search and folder ride along so «back» from there returns the
                                    reader to the list they were reading.
                                *@
                                <a href="@Url.Action("Detail", "Files", new { id = row.Id, q = Model.Query, folder = Model.Folder, tag = Model.Tag })">@row.Name</a>
                                @if (row.IsEncrypted)
                                {
                                    @* A glyph with a word behind it. The padlock is what the eye
                                       reads at a glance and the label is what a screen reader gets:
                                       an unlabelled ideogram is a row that says nothing at all to
                                       somebody listening to it. *@
                                    <span class="badge" title="@UiText.Files.Locked">
                                        <span aria-hidden="true">🔒</span>
                                        <span class="visually-hidden">@UiText.Files.Locked</span>
                                    </span>
                                }
                                @foreach (var label in row.Labels)
                                {
                                    <span class="badge badge--muted">@label.Name</span>
                                }
                            </div>
                            <div class="cell-num" dir="ltr" data-label="@UiText.Files.ColumnSize">@row.SizeText</div>
                            <div class="cell-muted" data-label="@UiText.Files.ColumnModified">@row.ModifiedText</div>
                            @if (row.FolderText is { } where)
                            {
                                <div class="cell-name cell-muted" title="@where" data-label="@lastColumn">@where</div>
                            }
                            else
                            {
                                <div class="@(row.ActiveLinkCount == 0 ? "cell-muted" : "cell-slug")"
                                     data-label="@lastColumn">@row.LinkText</div>
                            }
                        </div>
                    }
                }
            </div>

            @*
                The bar that acts on the ticked rows.

                It replaced two forms that used to live here — «move this file» and «delete this
                file», both about whichever row the detail panel was showing. A selection can do
                both and more, so keeping the singular pair would have been two controls for the
                subset of what the three below already do, on a screen this change exists to
                simplify.

                Always drawn while there are rows, and not only once something is ticked: with
                JavaScript off nothing can reveal it, and a bar that appears on a click is a bar
                somebody without a click never finds. The «۳ انتخاب شده» reading is filled in by the
                enhancement, and is empty until then.
            *@
            @if (Model.Rows.Count > 0)
            {
                <div class="dtable-foot">
                    <span data-selection-count class="muted"></span>
                    <span class="row" style="gap: 8px; flex-wrap: wrap;">
                        <span class="row" style="gap: 6px;">
                            <label class="visually-hidden" for="bulk-into">@UiText.Files.MoveTo</label>
                            <select id="bulk-into" name="destination" class="control">
                                @foreach (var choice in Model.MoveTargets)
                                {
                                    <option value="@choice.Id" selected="@(choice.Id == Model.Folder)">@choice.Label</option>
                                }
                            </select>
                            <button type="submit" name="act" value="move" class="btn btn--sm">@UiText.Files.Move</button>
                        </span>

                        <span class="row" style="gap: 6px;">
                            <label class="visually-hidden" for="bulk-label">@UiText.Files.Label</label>
                            <input id="bulk-label" name="label" class="control" maxlength="64" dir="auto"
                                   autocomplete="off" placeholder="@UiText.Files.Label" />
                            <button type="submit" name="act" value="tag" class="btn btn--sm">@UiText.Files.AddLabel</button>
                        </span>

                        <button type="submit" name="act" value="delete" class="btn btn--sm btn--danger">
                            @UiText.Files.Delete
                        </button>
                    </span>
                </div>
            }
            </form>
        </div>

        <aside class="split-aside">
            @await Html.PartialAsync("_FileDetail", Model)
        </aside>
    </div>
</div>
