@using DriveUnion.Core.Sharing
@using DriveUnion.Web.Models
@model FilesPageViewModel
@*
    One file, drawn the same way in two places.

    It is the body of the detail panel on «فایل‌ها» and the whole of /files/{id}, and it is a partial
    rather than two copies because those two would drift and the drift would be invisible: one of
    them would quietly stop offering «تماشا», or stop showing a lock, and nothing would fail.

    The page exists because the panel alone was not enough. Pressing a file scrolled a column into
    view somewhere off to the side, so watching a film meant remembering that you press the name,
    then scroll, then find the tile — three steps and a memory, for the one thing the product is for.
*@
    <div class="card card--flush">
        @if (Model.Selected is null)
        {
            <div class="empty">
                <span>@UiText.Files.DetailEmptyState</span>
            </div>
        }
        else
        {
            @if (Model.Selected.MediaKind is "video" or "audio")
            {
                @*
                    A link to a page, and not a player wedged into this column.

                    It used to be the player. On a phone that put a 320px element under a
                    summary row, a link list and — for a locked file — a passphrase field, in
                    a column narrow enough that the controls landed on top of each other.
                    Watching is what somebody opened the file for; it gets a screen.

                    Nothing is fetched by pressing this. The page it opens asks before it
                    spends anything, because /files/{id}/content is metered and capped
                    exactly as a share link is.
                *@
                <a class="ph detail-preview detail-watch"
                   href="@Url.Action("Watch", "Files", new { id = Model.Selected.Id })">
                    <span class="watch-play-glyph" aria-hidden="true">▶</span>
                    <span>@UiText.Player.Watch</span>
                </a>
            }
            else
            {
                <div class="ph detail-preview">
                    <span class="ph-label">@Model.Selected.KindText</span>
                </div>
            }

            <div class="card-body">
                @* The comp's «اکانت», «مسیر» and «شناسه درایو» rows are deliberately absent:
                   nothing a customer sees may name the Google account holding their file. *@
                <h2 class="card-title" style="font-size: 14.5px;">@Model.Selected.Name</h2>
                <p class="mono muted" dir="ltr" style="font-size: 11.5px; margin: 3px 0 14px;">
                    @Model.Selected.SizeText · @Model.Selected.KindText
                </p>

                <div class="row" style="font-size: 12.5px; margin-bottom: 16px;">
                    <span class="muted">@UiText.Files.CreatedLabel</span>
                    <span class="push-end">@Model.Selected.CreatedText</span>
                </div>

                @if (!Model.Selected.IsEncrypted)
                {
                    @*
                        Locking a file that is already here.

                        The whole card is server-rendered hidden and lockFile.ts reveals it.
                        That is not progressive enhancement being tidy — there is no
                        no-script version of this and there must not be one. Deriving the key
                        in the browser is the entire reason this route is safer than the
                        link-upload path it resembles: a form that posted the passphrase
                        would send the server the one secret that also opens every file the
                        customer ever locked in their own browser.

                        So without a bundle the card is simply absent, and the old remedy —
                        download it, delete it, upload it again with the box ticked — is
                        still there and still works.
                    *@
                    <div class="subcard" style="margin-bottom: 14px;"
                         data-island="lock-file"
                         data-lock-url="@Url.Action("Lock", "Files", new { id = Model.Selected.Id })"
                         data-lock-token="@Model.Antiforgery.Token"
                         data-lock-length="@Model.Selected.SizeBytes"
                         data-lock-working="@UiText.Locking.Working"
                         data-lock-queued="@UiText.Locking.Queued"
                         data-lock-failed="@UiText.Locking.Failed">
                        <form data-lock-form hidden class="stack" style="gap: 8px;">
                            <div class="field-label">🔓 @UiText.Locking.Title</div>

                            <p class="muted" style="font-size: 11.5px; line-height: 1.8; margin: 0;">
                                @UiText.Locking.Explain
                            </p>

                            <p class="muted" style="font-size: 11.5px; line-height: 1.8; margin: 0;">
                                @UiText.Locking.LinksWillStop @UiText.Locking.NeedsRoom
                            </p>

                            <label class="field-label" for="lock-secret-@Model.Selected.Id">
                                @UiText.Locking.SecretLabel
                            </label>
                            <input id="lock-secret-@Model.Selected.Id"
                                   data-lock-secret
                                   type="password"
                                   class="control"
                                   autocomplete="new-password" />

                            <button type="submit" data-lock-submit class="btn">
                                @UiText.Locking.Start
                            </button>

                            <p class="muted" data-lock-said role="status"
                               style="font-size: 11.5px; line-height: 1.8; margin: 0;"></p>
                        </form>
                    </div>
                }

                @if (Model.Selected.IsEncrypted)
                {
                    @* Said here rather than only drawn as a padlock, because this is where
                       the consequences are: the share link below behaves differently and the
                       bot will refuse the file, and both of those are better read now than
                       discovered by someone waiting for a delivery. *@
                    <p class="subcard muted" style="font-size: 12px; line-height: 1.8; margin-bottom: 14px;">
                        🔒 @UiText.Files.LockedExplained
                    </p>

                    @* Which of the two kinds it is. The padlock above says «encrypted»,
                       which is true of both and is the part that is not enough: one of them
                       the operator can never open and the other they saw on the way past. *@
                    @if (Model.Selected.SealedByText is { Length: > 0 } provenance)
                    {
                        <p class="muted" style="font-size: 11.5px; line-height: 1.8; margin: -6px 0 14px;">
                            @provenance
                        </p>
                    }
                }

                @if (Model.Selected.ActiveLink is { } link)
                {
                    <div class="subcard" style="margin-bottom: 14px;">
                        <div class="row" style="margin-bottom: 9px;">
                            <span style="font-size: 12.5px; font-weight: 700;">@UiText.Files.ActiveLinkHeading</span>
                            <span class="badge push-end">@UiText.Files.PublicBadge</span>
                        </div>
                        <div class="field" dir="ltr">
                            <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@link.DisplayUrl</span>
                            <button type="button"
                                    class="btn btn--sm"
                                    data-island="copy-link"
                                    data-value="@link.PublicUrl">@UiText.Files.Copy</button>
                            @*
                                The phone's own share sheet, beside the copy button and not
                                instead of it: on a phone nobody wants this link on their
                                clipboard, they want it in a message to one person — and on
                                a desktop there is no sheet to open at all.

                                Rendered hidden, and shown by copyLink.ts only where
                                `navigator.share` exists. That is a question no server can
                                answer: the call is absent outside a secure context and on
                                every browser without a sheet, and a button that throws when
                                pressed leaves the reader believing they have sent the link.
                                Nothing is lost by hiding it — the button beside it is what
                                that reader has always used.

                                It carries no address of its own. The one on the copy button
                                is the address, and two copies of it in one box are two to
                                keep in step. The wording travels on the element for the
                                reason the redirect-URI copy control's does: a bundle is
                                compiled once and cannot ask which language this request is
                                in.
                            *@
                            <button type="button"
                                    class="btn btn--sm"
                                    data-share
                                    data-share-title="@Model.Selected.Name"
                                    data-share-text="@UiText.Sharing.ShareMessage(Model.Selected.Name)"
                                    data-share-refused="@UiText.Sharing.ShareRefused"
                                    hidden>@UiText.Sharing.Share</button>
                        </div>
                        <div class="row mono muted" style="gap: 14px; font-size: 11px; margin-top: 9px;">
                            <span>@link.DownloadsText</span>
                            <span>@link.ExpiryText</span>
                        </div>

                        @if (Model.Selected.IsEncrypted)
                        {
                            @* Which secret this link needs. The two are very different
                               things to have handed somebody, and without this the owner has
                               no way to tell one link from the other afterwards. *@
                            <p class="muted" style="font-size: 11px; line-height: 1.7; margin: 9px 0 0;">
                                🔒 @(link.HasOwnKey
                                    ? UiText.Files.LinkHasOwnKey
                                    : UiText.Files.LinkUsesYourPassphrase)
                            </p>
                        }
                    </div>

                    @*
                        The link as a picture, for the case the address has to cross to a phone that
                        is not this one — read out over a call, or typed off a laptop screen. A slug
                        is eight characters of base32 and every one of them is a chance to mistype.

                        Behind a disclosure because most links are copied, not scanned, and a code on
                        every row would be a column of noise. Rendered inline rather than fetched:
                        the SVG is a few hundred bytes and a request per link, per row, to draw
                        something most readers never open would be the expensive way round.

                        The address is not in the markup of the picture — see UiText.LinkQr.PictureLabel.
                    *@
                    <details class="link-qr">
                        <summary>@UiText.LinkQr.Show</summary>
                        @Html.Raw(LinkQrCode.Svg(link.PublicUrl, UiText.LinkQr.PictureLabel))
                    </details>

                    <div class="row" style="gap: 8px;">
                        <form method="post"
                              style="flex: 1;"
                              action="@Url.Action("RevokeLink", "Files", new { fileId = Model.Selected.Id, linkId = link.Id, q = Model.Query, folder = Model.Folder })">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn--block">@UiText.Files.RevokeLink</button>
                        </form>
                        <a class="btn btn--primary" style="flex: 1;" href="@link.PublicUrl" target="_blank" rel="noopener">
                            @UiText.Files.OpenPublicPage
                        </a>
                    </div>
                }
                else
                {
                    <p class="muted" style="font-size: 12.5px; margin: 0 0 12px;">@UiText.Files.NoPublicLink</p>
                    <form method="post" action="@Url.Action("CreateLink", "Files", new { id = Model.Selected.Id, q = Model.Query, folder = Model.Folder })">
                        @Html.AntiForgeryToken()
                        @*
                            Optional, and above the button rather than behind a «more
                            options» toggle: it is one field, and the moment somebody has to
                            press something to find it is the moment nobody writes a note.

                            maxlength matches the column, so the browser stops the typing
                            rather than the server silently keeping the first 280 characters
                            of what was typed.
                        *@
                        <label class="field-label" for="link-note">@UiText.Files.LinkNoteLabel</label>
                        <textarea id="link-note"
                                  name="note"
                                  class="control"
                                  rows="2"
                                  maxlength="@ShareLink.MaxNoteLength"
                                  placeholder="@UiText.Files.LinkNotePlaceholder"></textarea>
                        <p class="muted" style="font-size: 11px; line-height: 1.7; margin: 6px 0 10px;">
                            @UiText.Files.LinkNoteHint
                        </p>

                        @if (Model.Selected.EncryptionJson is { } fileHeader)
                        {
                            @*
                                Sharing a locked file is not a form post. The key has to be
                                re-wrapped in this browser, because this browser is the only
                                place the content key can exist — so the island below does
                                that and fills in the one field that gets posted.

                                The button is rendered disabled and the island enables it.
                                Pressing it beforehand would make a link carrying the file's
                                original wrapped key, which needs the owner's own passphrase
                                — the passphrase that also opens everything uploaded in the
                                same batch. That link would work, for the wrong secret, and
                                the owner would learn about it from the person they sent it
                                to. So it is refused, and the noscript below says why.
                            *@
                            <div data-island="share-locked-file"
                                 data-header="@fileHeader"
                                 data-file-name="@Model.Selected.Name"
                                 data-lang="@(PanelCulture.IsPersian ? "fa" : "en")"></div>

                            <noscript>
                                <p class="muted" style="font-size: 11.5px; line-height: 1.8; margin: 0 0 10px;">
                                    @UiText.Files.ShareLockedNeedsScript
                                </p>
                            </noscript>

                            <button type="submit"
                                    class="btn btn--primary btn--block"
                                    data-share-submit
                                    disabled>@UiText.Files.CreateLink</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn--primary btn--block">@UiText.Files.CreateLink</button>
                        }
                    </form>
                }
            </div>
        }
    </div>
