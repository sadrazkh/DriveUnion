@using DriveUnion.Web.Models
@model UploadPageViewModel
@{
    ViewData["Title"] = UiText.Files.UploadTitle;
}

<div class="stack" style="gap: 16px;">
    <div class="stack" style="gap: 4px;">
        <h1 class="page-title">@UiText.Files.UploadTitle</h1>
        <p class="page-sub">@UiText.Files.UploadSubtitle</p>

        @*
            Said here, above everything, because on a phone it is the first thing that will happen
            and the first thing that will be reported as a fault.

            It is rendered by Razor rather than by the island for the reason UiText.Transfers gives:
            the island's words are a pair of dictionaries inside the .vue, reachable from the
            catalogue only through the mount point, and the dock's mount point is not this screen's
            to write. A sentence about the product belongs to the screen anyway — it is not the
            label of a control.
        *@
        <p class="muted" role="note"
           style="font-size: 12px; line-height: 1.8; margin: 4px 0 0; max-width: 68ch;">
            @UiText.Transfers.LeavingTheAppPauses
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <p class="page-sub" role="status">@Model.Notice</p>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="page-sub" role="alert" style="color: var(--danger);">@Model.Error</p>
    }

    <div class="card card--pad">
        @*
            The mount point carries no props any more, and that is the change this screen is.

            The queue is not this page's — it lives in the shell, above the content navigation
            swaps, so a transfer survives walking around the panel. Everything the island needs
            comes from `data-upload-config` in _Layout.cshtml: the begin URL, the antiforgery
            header and token, and the language. The token in particular has to come from there,
            because it is per-response and an upload outlives many responses.

            Both ways in live inside it now — sending a file and asking the server to fetch one —
            because they are the same act to the person doing them and were two entirely different
            screens. One tab strip, one lock over both, one list of what is arriving.
        *@
        <div data-island="upload-panel">
            <div class="empty">
                <span>@UiText.Files.UploadNeedsScript</span>
                <a class="btn" href="@Url.Action("Index", "Files")">@UiText.Files.BackToFiles</a>
            </div>
        </div>
    </div>

    @*
        The link form for a reader with no script, and nothing else.

        Sending a file genuinely needs JavaScript — the browser will not read one without it — but
        fetching a link does not, and a feature that works without script should not be switched off
        because its neighbour cannot be. It posts to the same two routes the island calls; they
        answer JSON when asked for JSON and redirect here otherwise, so there is one pair of routes
        and one wording of every refusal.

        Inside <noscript> so it does not appear twice for everybody else.
    *@
    <noscript>
        <div class="card card--pad stack" style="gap: 12px;">
            <div>
                <h2 class="card-title">@UiText.Files.FetchHeading</h2>
                <p class="muted" style="font-size: 12px; line-height: 1.8; margin: 4px 0 0; max-width: 66ch;">
                    @UiText.Files.FetchHint
                </p>
            </div>

            <form method="post" class="stack" style="gap: 8px;" action="@Url.Action("Fetch", "Files")">
                @Html.AntiForgeryToken()

                <label class="field-label" for="fetch-url-plain">@UiText.Files.FetchUrlLabel</label>
                <input id="fetch-url-plain"
                       name="url"
                       type="url"
                       class="control mono"
                       dir="ltr"
                       required
                       maxlength="@DriveUnion.Core.Uploads.RemoteSource.MaxUrlLength"
                       autocomplete="off"
                       placeholder="https://…" />

                @*
                    There is no passphrase box here any more, and its absence is the feature.

                    The server used to take what was typed and derive from it. That was defensible —
                    it is about to download the plaintext anyway — right up until you notice that
                    people use one secret for everything, so a server that had seen it once could
                    open every file that customer had locked in their own browser. The deriving
                    happens in the browser now, and a form cannot derive.

                    So without script a link can still be fetched, and it arrives readable. Offering
                    the box and quietly using the weaker protocol behind it would have been worse
                    than not offering it: the customer would believe they had locked something.
                *@
                <p class="muted" style="font-size: 11.5px; line-height: 1.8; margin: 0; max-width: 62ch;">
                    @UiText.Fetching.NoLockWithoutScript
                </p>

                <button type="submit" class="btn btn--primary">@UiText.Files.FetchStart</button>
            </form>

            @if (Model.Fetches.Count > 0)
            {
                <div class="stack" style="gap: 8px;">
                    @foreach (var fetch in Model.Fetches)
                    {
                        <div class="subcard stack" style="gap: 6px;">
                            <div class="row" style="gap: 10px; flex-wrap: wrap;">
                                <span style="font-size: 12.5px; font-weight: 600;" dir="auto">@fetch.Name</span>
                                <span class="badge push-end">@fetch.StatusText</span>
                            </div>

                            <span class="mono muted" dir="ltr"
                                  style="font-size: 11px; overflow-wrap: anywhere;">@fetch.Url</span>

                            <span class="mono muted" dir="ltr" style="font-size: 11px;">@fetch.ProgressText</span>

                            @if (fetch.FailureReason is { Length: > 0 } why)
                            {
                                <p class="muted" style="font-size: 11px; line-height: 1.7; margin: 0;"
                                   dir="auto">@why</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </noscript>
</div>
