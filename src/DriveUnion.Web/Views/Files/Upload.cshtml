@{
    ViewData["Title"] = UiText.Files.UploadTitle;
}

<div class="stack" style="gap: 16px;">
    <div class="stack" style="gap: 4px;">
        <h1 class="page-title">@UiText.Files.UploadTitle</h1>
        <p class="page-sub">@UiText.Files.UploadSubtitle</p>
    </div>

    <div class="card card--pad">
        @*
            The mount point carries no props any more, and that is the change this screen is.

            The queue is not this page's — it lives in the shell, above the content navigation
            swaps, so a transfer survives walking around the panel. Everything the island needs
            comes from `data-upload-config` in _Layout.cshtml: the begin URL, the antiforgery
            header and token, and the language. The token in particular has to come from there,
            because it is per-response and an upload outlives many responses.

            What this screen adds to the corner dock is room: the concurrency choice, the
            checkboxes, and the sentence about what a reload costs.
        *@
        <div data-island="upload-panel">
            <div class="empty">
                <span>@UiText.Files.UploadNeedsScript</span>
                <a class="btn" href="@Url.Action("Index", "Files")">@UiText.Files.BackToFiles</a>
            </div>
        </div>
    </div>
</div>
