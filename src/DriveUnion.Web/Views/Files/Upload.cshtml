@using DriveUnion.Web.Models
@model UploadPageViewModel
@{
    ViewData["Title"] = UiText.Files.UploadTitle;
}

<div class="stack" style="gap: 16px;">
    <div class="stack" style="gap: 4px;">
        <h1 class="page-title">@UiText.Files.UploadTitle</h1>
        <p class="page-sub">@UiText.Files.UploadSubtitle</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <p class="page-sub" role="status">@Model.Notice</p>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="page-sub" role="alert" style="color: var(--danger);">@Model.Error</p>
    }

    <div class="card card--pad">
        @*
            The mount point carries no props any more, and that is the change this screen is.

            The queue is not this page's — it lives in the shell, above the content navigation
            swaps, so a transfer survives walking around the panel. Everything the island needs
            comes from `data-upload-config` in _Layout.cshtml: the begin URL, the antiforgery
            header and token, and the language. The token in particular has to come from there,
            because it is per-response and an upload outlives many responses.

            What this screen adds to the corner dock is room: the concurrency choice, the
            checkboxes, and the sentence about what a reload costs.
        *@
        <div data-island="upload-panel">
            <div class="empty">
                <span>@UiText.Files.UploadNeedsScript</span>
                <a class="btn" href="@Url.Action("Index", "Files")">@UiText.Files.BackToFiles</a>
            </div>
        </div>
    </div>

    @*
        The other way in, and the one that needs no script at all.

        A plain form post, deliberately: the whole promise here is that the customer's machine is
        not involved, so a control that only works while a tab is open would be the wrong shape for
        it. Paste, press, close the browser — the worker does the rest.
    *@
    <div class="card card--pad stack" style="gap: 12px;">
        <div>
            <h2 class="card-title">@UiText.Files.FetchHeading</h2>
            <p class="muted" style="font-size: 12px; line-height: 1.8; margin: 4px 0 0; max-width: 66ch;">
                @UiText.Files.FetchHint
            </p>
        </div>

        <form method="post" class="stack" style="gap: 8px;" action="@Url.Action("Fetch", "Files")">
            @Html.AntiForgeryToken()

            <label class="field-label" for="fetch-url">@UiText.Files.FetchUrlLabel</label>
            @*
                type="url" so a phone offers the right keyboard and the browser catches the obvious
                mistakes first. It is not the check that matters — that one is on the server, and
                the address this resolves to is checked again at the moment a socket is opened.

                dir="ltr" because a URL is a Latin run, and in an RTL page it is reordered into
                something unreadable otherwise.
            *@
            <input id="fetch-url"
                   name="url"
                   type="url"
                   class="control mono"
                   dir="ltr"
                   required
                   maxlength="@DriveUnion.Core.Uploads.RemoteSource.MaxUrlLength"
                   autocomplete="off"
                   placeholder="https://…" />

            @*
                Optional, and the warning is inside it rather than beside the tick.

                The two kinds of encryption in this product are the same format and very different
                promises, and this is the weaker one — the server is the thing fetching the file, so
                it sees the contents while it does. Somebody who ticks this without reading that has
                been misled by the product, so the sentence sits where the choice is made and names
                the other option by the words on its own control.
            *@
            <details class="disclose">
                <summary class="btn btn--sm">@UiText.Files.FetchLock</summary>
                <div class="disclose-body stack" style="gap: 8px;">
                    <p class="muted" style="font-size: 11.5px; line-height: 1.8; margin: 0; max-width: 62ch;">
                        @UiText.Files.FetchLockWarning
                    </p>

                    <label class="field-label" for="fetch-secret">@UiText.Files.FetchSecretLabel</label>
                    <input id="fetch-secret"
                           name="secret"
                           type="password"
                           class="control"
                           autocomplete="new-password" />
                </div>
            </details>

            <button type="submit" class="btn btn--primary">@UiText.Files.FetchStart</button>
        </form>

        @if (Model.Fetches.Count == 0)
        {
            <p class="muted" style="font-size: 12px; margin: 0;">@UiText.Files.FetchNothingYet</p>
        }
        else
        {
            <div class="stack" style="gap: 8px;">
                @foreach (var fetch in Model.Fetches)
                {
                    <div class="subcard stack" style="gap: 6px;">
                        <div class="row" style="gap: 10px; flex-wrap: wrap;">
                            <span style="font-size: 12.5px; font-weight: 600;" dir="auto">@fetch.Name</span>
                            <span class="badge push-end">@fetch.StatusText</span>
                        </div>

                        @* The address as typed, which is Latin and must state its own direction. *@
                        <span class="mono muted" dir="ltr"
                              style="font-size: 11px; overflow-wrap: anywhere;">@fetch.Url</span>

                        <div class="row" style="gap: 12px; flex-wrap: wrap;">
                            <span class="mono muted" dir="ltr" style="font-size: 11px;">@fetch.ProgressText</span>

                            @if (fetch.IsLive)
                            {
                                <form method="post" class="push-end"
                                      action="@Url.Action("CancelFetch", "Files", new { id = fetch.Id })">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn--sm">@UiText.Accounts.Cancel</button>
                                </form>
                            }
                        </div>

                        @if (fetch.FailureReason is { Length: > 0 } why)
                        {
                            <p class="muted" style="font-size: 11px; line-height: 1.7; margin: 0;"
                               dir="auto">@why</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
