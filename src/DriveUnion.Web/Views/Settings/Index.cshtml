@using DriveUnion.Web.Models
@model OperatorSettingsPageViewModel
@{
    ViewData["Title"] = UiText.OperatorSettings.Title;
}

@*
    The operator's own screen. Nothing here is ever rendered for a customer: the controller is behind
    the operator policy and the nav entry behind the same claim.

    The two sentences under the field are the point of the page. The number is easy to collect and
    easy to misread — an operator who lowers it expecting yesterday's deletions to go tonight has
    been told something untrue by their absence.
*@
<div class="stack" style="gap: 16px;">
    <div class="page-head">
        <h1 class="page-title">@UiText.OperatorSettings.Title</h1>
        <span class="page-sub">@UiText.OperatorSettings.Subtitle</span>
    </div>

    @if (Model.Notice is not null)
    {
        <p class="notice" role="status">@Model.Notice</p>
    }

    @if (Model.Error is not null)
    {
        <p class="notice notice--danger" role="alert">@Model.Error</p>
    }

    <div class="card">
        <div class="card-head">
            <div class="card-title">@UiText.OperatorSettings.RetentionHeading</div>
            <span class="hint">@Model.LastChangedText</span>
        </div>

        <div class="card-body">
            <div class="stack" style="gap: 14px;">
                @* Above the field, not under it. What this number does not do is the half an
                   operator will otherwise assume, and it is the half that destroys files early. *@
                <p class="hint">@UiText.OperatorSettings.RetentionAppliesForward</p>
                <p class="hint">@UiText.OperatorSettings.RetentionAndEmptying</p>

                <form method="post"
                      action="@Url.Action("Retention", "Settings")"
                      class="row"
                      style="gap: 12px; flex-wrap: wrap; align-items: flex-end;">
                    @Html.AntiForgeryToken()

                    <div class="form-field" style="flex: 0 1 200px;">
                        <label class="field-label" for="retention-days">@UiText.OperatorSettings.RetentionField</label>
                        @* .field rather than .control: the box is shared with the unit beside it,
                           which is what .field is for. The number is a Latin readout in either
                           language and the input says so for itself. *@
                        <span class="field">
                            <input id="retention-days"
                                   name="Days"
                                   type="number"
                                   inputmode="numeric"
                                   dir="ltr"
                                   required
                                   min="@OperatorSettingsPageViewModel.Minimum"
                                   max="@OperatorSettingsPageViewModel.Maximum"
                                   step="1"
                                   value="@Model.Values.Days" />
                            <span class="field-prefix">@UiText.OperatorSettings.UnitDays</span>
                        </span>
                    </div>

                    <button type="submit" class="btn btn--primary">@UiText.OperatorSettings.Save</button>
                </form>

                <div class="stack" style="gap: 6px;">
                    <p class="hint">@OperatorSettingsPageViewModel.BoundsText</p>
                    <p class="hint">@UiText.OperatorSettings.RetentionWhyBounds</p>
                </div>
            </div>
        </div>
    </div>
</div>
