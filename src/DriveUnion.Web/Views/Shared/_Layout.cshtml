@using DriveUnion.Web.Security
@using Microsoft.Extensions.DependencyInjection
@{
    var shell = ShellContext.From(ViewData);
    var title = ViewData["Title"] as string;
    var controller = ViewContext.RouteData.Values["controller"] as string ?? "Home";

    // Everything about the Google pool hangs off this one question, asked of the principal rather
    // than carried on ShellContext. The claim is the same fact DriveUnionPolicies.Operator
    // authorises on, so the sidebar shows exactly what /accounts would let this caller in to see. A
    // bool on the view model would be a second copy of that fact which every page has to remember
    // to set correctly, and the two can disagree without anything failing — here there is nothing
    // to set and nothing to forget.
    var isOperator = User.IsOperator();

    // The sign-out control, and only that. Asked of the principal for the same reason as above: the
    // sign-in page renders this layout too, and a footer offering to end a session nobody has is a
    // form that can only 401.
    var isSignedIn = User.Identity?.IsAuthenticated == true;

    // Asked of the principal for the same reason isOperator is, and the same way AccessDenied asks
    // it: it is the fact DriveUnionPolicies.Tenant authorises on, so what the sidebar draws and what
    // the route allows cannot disagree.
    var hasWorkspace = User.GetTenantId() is not null;

    // The comp's «جست‌وجو در همه‌ی اکانت‌ها…» is the operator reading the union of the pool. A
    // customer has one library and must not be told it is spread across accounts.
    var searchLabel = isOperator ? UiText.Shell.SearchEveryAccount : UiText.Shell.SearchFiles;

    // Where the language switch sends the visitor back to — this page, query string and all, so a
    // filtered file list or a search survives the switch. The controller only follows it if it is
    // local.
    var here = Context.Request.Path + Context.Request.QueryString;

    // The customer's own capacity card, which is the operator's card's box and none of its figures.
    //
    // Asked for here rather than carried on ShellContext, because the sidebar is drawn on every
    // screen in the panel and those screens belong to other slices: a card that appeared only where
    // a controller remembered to fill it in would be missing from exactly the pages a customer is on
    // when they wonder where their space went. It is the same reason isOperator is asked of the
    // principal — one answer, in one place, that no page can get wrong.
    //
    // Resolved rather than @injected, and null-tolerantly. The panel boots without this slice's
    // registration until Program.cs carries `AddDriveUnionTrashPanel()`, and an @inject of an
    // unregistered service is an exception on every page in the panel rather than one card fewer.
    ShellCapacity? capacity = null;

    if (!isOperator && User.GetTenantId() is { } shellTenantId)
    {
        var capacityReader = Context.RequestServices.GetService<IShellCapacity>();

        if (capacityReader is not null)
        {
            capacity = await capacityReader.ReadAsync(shellTenantId, Context.RequestAborted);
        }
    }

    string NavClass(string name) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase)
            ? "nav-item is-active"
            : "nav-item";
}
@*
    The panel shell: fixed sidebar (232px, inline-end in RTL), sticky header, content at
    24px 26px 40px. The public download page has its own layout because it is chrome-less, not
    because it needs different tokens.

    Nothing here says left or right. The same primitives set the LTR public page and the LTR
    English panel; a single `padding-left` would mean a second stylesheet.

    Every string is an entry in UiText and every reading of the language is PanelCulture — see
    Localization/README.md. A literal Persian word in this file is a word the English panel cannot
    say, and a `dir="rtl"` hard-coded on the document is an English panel laid out backwards.

    Navigation uses literal hrefs rather than asp-controller/asp-action deliberately. Link
    generation is endpoint-based: the anchor tag helper throws when no controller is registered for
    the pair, so the shell would take the whole panel down for as long as any one of these
    controllers is unwritten. The conventional route is {controller}/{action}/{id?} and these paths
    match it.

    Every mention of an account, the pool or its quota is behind `isOperator` (M1 spec §1.4).
    Not hidden — absent: a customer must not be able to tell from this markup that a pool exists.
*@
<!DOCTYPE html>
<html dir="@PanelCulture.Direction" lang="@PanelCulture.Code" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(string.IsNullOrEmpty(title) ? UiText.Brand.Name : UiText.Brand.PageTitle(title))</title>
    <partial name="_HeadAssets" />
</head>
<body>
<div class="app-shell" data-shell>
    <div class="nav-scrim" data-nav-scrim></div>

    <nav class="app-sidebar" aria-label="@UiText.Shell.NavigationLabel">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true">@UiText.Brand.Mark</span>
            <span class="brand-text">
                <span class="brand-name">@UiText.Brand.Name</span>
                @if (isOperator)
                {
                    @* «2 accounts · 10 TB» is a count of the pool. The skeleton is no safer: an
                       empty placeholder still announces that a figure belongs here. *@
                    if (shell.AccountSummary is { Length: > 0 } summary)
                    {
                        <span class="brand-sub" dir="ltr">@summary</span>
                    }
                    else
                    {
                        <span class="skeleton" style="height: 9px; width: 88px; margin-top: 4px;"></span>
                    }
                }
            </span>
        </div>

        <a class="@NavClass("Home")" href="/">
            <span class="nav-dot" aria-hidden="true"></span>@UiText.Shell.Dashboard
        </a>
        <a class="@NavClass("Files")" href="/Files">
            <span class="nav-dot" aria-hidden="true"></span>@UiText.Shell.Files
        </a>
        @if (!isOperator && hasWorkspace)
        {
            @* The other half of «فایل‌ها», and a primary nav item rather than a link inside that
               screen: a customer looking for the space a delete did not give back is looking at the
               menu, not at the table they just deleted from. It is a tenant item — the operator's
               trash is every workspace's at once, which is a screen nobody has asked for. *@
            <a class="@NavClass("Trash")" href="/trash">
                <span class="nav-dot" aria-hidden="true"></span>@UiText.Trash.Title
            </a>
        }
        @*
            Queue and Settings are M3 and M6 (spec §12) and have no controller. Rendered so the
            shell is the comp's, marked so a click is not a 404 — a dead primary nav item teaches
            an operator to distrust the whole menu.
        *@
        <span class="nav-item nav-item--split" aria-disabled="true" title="@UiText.Shell.NextRelease">
            <span class="row"><span class="nav-dot" aria-hidden="true"></span>@UiText.Shell.TransferQueue</span>
        </span>
        <a class="@NavClass("Links")" href="/Links">
            <span class="nav-dot" aria-hidden="true"></span>@UiText.Shell.ShareLinks
        </a>
        @if (isOperator)
        {
            @* AccountsController already answers a customer with 403; this keeps the words
               «اکانت‌های گوگل» out of their markup, which is the half a policy cannot do. *@
            <a class="@NavClass("Accounts")" href="/Accounts">
                <span class="nav-dot" aria-hidden="true"></span>@UiText.Shell.GoogleAccounts
            </a>
            @* The two screens that replaced "set four environment variables and redeploy": the
               workspaces the operator sells to, and the tiers they are sold on. Both are behind the
               Operator policy in their controllers; this only decides what is drawn. *@
            <a class="@NavClass("Tenants")" href="/operator/tenants">
                <span class="nav-dot" aria-hidden="true"></span>@UiText.Tenants.Title
            </a>
            <a class="@NavClass("Plans")" href="/operator/plans">
                <span class="nav-dot" aria-hidden="true"></span>@UiText.Plans.OperatorTitle
            </a>
        }
        else if (hasWorkspace)
        {
            @* The customer's own card — what they are allowed, and how much of it is spent. The
               operator's catalogue is a different address and a different screen. *@
            <a class="@NavClass("Plans")" href="/plans">
                <span class="nav-dot" aria-hidden="true"></span>@UiText.Plans.Title
            </a>
        }
        @*
            The comp's last slot is «تنظیمات», and it now exists — for the operator. It holds the
            settings that belong to no workspace and apply to all of them, which is one so far: how
            long the trash keeps a file. A customer has no such screen and must not be shown one,
            because every setting on it is a decision about the operator's own storage.

            Beside it, the only other settings a signed-in caller has — Telegram (Telegram design
            §9.1 for the operator's bot, §9.2 for the customer's own link, which lives at its own
            address until a customer-facing settings screen exists to hold its card).

            Two audiences, two addresses. Each controller authorises its own end, so this decides
            what is drawn and not what is allowed: a customer who guesses /operator/settings gets a
            403 rather than the retention form, and one who guesses /telegram gets a 403 rather than
            the operator's bot token screen.
        *@
        @if (isOperator)
        {
            <a class="@NavClass("Telegram")" href="/telegram">
                <span class="nav-dot" aria-hidden="true"></span>@UiText.Shell.TelegramBot
            </a>
            <a class="@NavClass("Settings")" href="/operator/settings">
                <span class="nav-dot" aria-hidden="true"></span>@UiText.Shell.Settings
            </a>
        }
        else if (hasWorkspace)
        {
            <a class="@NavClass("Telegram")" href="/telegram/link">
                <span class="nav-dot" aria-hidden="true"></span>@UiText.Shell.Telegram
            </a>
        }
        else
        {
            @* Nobody is signed in — the sign-in page wears this shell too, and a nav item that can
               only challenge is a control that does nothing. *@
            <span class="nav-item" aria-disabled="true" title="@UiText.Shell.NextRelease">
                <span class="nav-dot" aria-hidden="true"></span>@UiText.Shell.Settings
            </span>
        }

        <div class="sidebar-foot">
            @if (isOperator)
            {
                @* 750 GB a day is what Google allows each account in the operator's pool; it is not
                   a customer's allowance and not a customer's business. Rendering the card empty
                   for a tenant only defers the disclosure to whoever first fills ShellContext in on
                   a panel page, so the whole card is absent — label, bar and skeleton. *@
                <div class="subcard">
                    <div class="bar-label" style="font-size: 11.5px; margin-bottom: 7px;">
                        <span>@UiText.Shell.TodaysUploadQuota</span>
                        @if (shell.HasQuota)
                        {
                            @* Latin in both languages, and dir="ltr" says so: a quota readout is a
                               technical figure an operator compares against Google's own console,
                               not a number set in prose. *@
                            <span class="mono" dir="ltr">@shell.DailyQuotaUsedGb / @shell.DailyQuotaLimitGb GB</span>
                        }
                    </div>
                    @if (shell.HasQuota)
                    {
                        <div class="bar">
                            <span class="@shell.QuotaFillClass"
                                  style="width: @shell.QuotaPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                        </div>
                    }
                    else
                    {
                        @* No quota reading yet — a skeleton, never a plausible number. *@
                        <div class="skeleton" style="height: 6px;"></div>
                    }
                </div>
            }
            else if (capacity is not null)
            {
                @*
                    The customer's card: the operator's box, and not one of the operator's figures.

                    The ask was «like the operator», and the operator's card reads the daily 750 GB
                    each Google account is allowed — a fact about the pool, and exactly what M1 §1.4
                    says a customer must never see. These three are the customer's own: what they
                    have stored against the cap they bought, the traffic their plan includes this
                    month, and what their trash is holding.

                    The trash figure is here because it is the difference between what a customer
                    believes they freed and what they actually did, which is the misunderstanding
                    this phase exists to end. It is a link, because the answer to «why is that not
                    zero» is one press away.
                *@
                <div class="subcard capacity">
                    <div class="capacity-row">
                        <span>@UiText.Capacity.StorageLabel</span>
                        <span class="mono" dir="ltr">@capacity.StorageText</span>
                    </div>
                    <div class="bar">
                        <span class="@capacity.StorageFillClass"
                              style="width: @capacity.StoragePercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                    </div>

                    @* No bar. The spent half of this one is P2's meter, and a bar drawn from an
                       allowance alone would be a bar that is always empty. *@
                    <div class="capacity-row" title="@UiText.Capacity.TrafficNotMeteredYet">
                        <span>@UiText.Capacity.TrafficLabel</span>
                        <span class="mono" dir="ltr">@capacity.TrafficText</span>
                    </div>

                    <a class="capacity-row capacity-link" href="/trash" title="@UiText.Capacity.TrashTitle">
                        <span>@UiText.Capacity.TrashLabel</span>
                        <span class="mono" dir="ltr">@capacity.TrashText</span>
                    </a>
                </div>
            }

            @if (isOperator)
            {
                @* The comp's dashed button previews the public page, which needs a slug this shell
                   does not have; that control belongs on a row that owns one. The living style
                   guide is what is genuinely one click away — for the operator. /design draws the
                   comp's account filter, its «اکانت» column and the daily-quota rule, so a
                   customer's shell must not point at it. The page itself is still anonymous; only
                   DesignController can close that, and it is not this file's to change. *@
                <a class="btn btn--dashed" href="/Design">@UiText.Shell.DesignGuide</a>
            }

            @* The name and role carry `title` as well as their own text: the row truncates them to
               fit a 232px sidebar (see .sidebar-identity in app.css), and a truncated address has to
               stay readable somewhere. *@
            <div class="row sidebar-identity">
                <span class="avatar" aria-hidden="true">@(shell.UserName is { Length: > 0 } n ? n[..1] : UiText.Shell.UnknownInitial)</span>
                <span class="sidebar-identity-text">
                    <span class="sidebar-identity-name" title="@shell.UserName">@(shell.UserName ?? "—")</span>
                    <span class="sidebar-identity-role muted" title="@shell.UserRole">@(shell.UserRole ?? "—")</span>
                </span>
                @if (isSignedIn)
                {
                    @*
                        Ending a session is a POST. On a GET any «img src» on any page signs the
                        operator out, and a browser that prefetches sidebar links does it without
                        anyone clicking. The literal action is the same address Program.cs gives the
                        cookie handler as its LogoutPath, and it is spelled out here for the reason
                        the navigation above is: a helper that cannot resolve would post the form to
                        the current page, which is worse than a 404.

                        The button wears .nav-item because that rule is already a button reset —
                        border: 0, font: inherit, transparent background, cursor: pointer — so this
                        is the sidebar's own control at the row's end rather than a second one bolted
                        underneath. It sits in the identity row because that is whose session it is.
                        The smaller padding and type it wears there are in app.css, under
                        .sidebar-identity-out, rather than in a style attribute nothing can test.
                    *@
                    <form method="post" action="/Identity/Account/Logout" class="push-end sidebar-identity-out">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="nav-item"
                                title="@UiText.Shell.SignOutTitle">@UiText.Shell.SignOut</button>
                    </form>
                }
            </div>
        </div>
    </nav>

    <div class="app-main">
        <header class="app-header">
            <button type="button" class="btn btn--sm nav-toggle" data-nav-toggle aria-expanded="false">
                <span aria-hidden="true">☰</span>
                <span class="visually-hidden">@UiText.Shell.Menu</span>
            </button>

            <form class="search" method="get" action="/Files" role="search">
                <span class="muted" aria-hidden="true">⌕</span>
                <label class="visually-hidden" for="shell-search">@searchLabel</label>
                <input id="shell-search" name="q" placeholder="@(searchLabel + "…")" />
                <span class="kbd" aria-hidden="true">⌘K</span>
            </form>

            <div class="row push-end" style="gap: 8px;">
                @*
                    The language switch, beside the theme control and not inside it: the island's
                    mount point is replaced wholesale by Vue, so anything server-rendered in there is
                    gone the moment the bundle loads.

                    A form and not a link because it writes a cookie that outlives the request, and
                    a plain form because the panel has to be usable with JavaScript off — which is
                    the entire reason the language is resolved on the server. The label is the other
                    language's own name, so somebody who cannot read this page can still find it.
                *@
                <form method="post" action="/Culture/Set" class="row">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="culture" value="@PanelCulture.OtherCode" />
                    <input type="hidden" name="returnUrl" value="@here" />
                    <button type="submit"
                            class="btn btn--sm"
                            lang="@PanelCulture.OtherCode"
                            title="@UiText.Shell.LanguageSwitchTitle">@UiText.Shell.LanguageSwitch</button>
                </form>

                @* The island. Server-rendered fallback inside the mount point: Vue replaces it, and
                   if the bundle never loads the page is short one control rather than broken.
                   data-lang is the resolved culture, so the theme button labels itself in the
                   language the rest of the page is in. *@
                <span data-island="theme-language" data-lang="@PanelCulture.Code">
                    <noscript>@UiText.Shell.ThemeNeedsScript</noscript>
                </span>
                <a class="btn btn--primary btn--lg" href="/Files/Upload">@UiText.Shell.Upload</a>
            </div>
        </header>

        <main class="app-content">
            @RenderBody()
        </main>
    </div>
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
