@inject ViteManifest Vite
@{
    var (viteJs, viteCss) = Vite.Resolve("Scripts/main.ts");
}
@*
    Shared by _Layout and _PublicLayout. One copy, because the order of these five things is the
    whole no-flash story and it is not obvious enough to trust to a second transcription.

    Order matters:
      1. the theme script, before any stylesheet, so data-theme is settled before first paint;
      2. fonts, so the @font-face is known when the text is laid out;
      3. tokens, which everything else reads;
      4. app.css, the shell and primitives;
      5. Vite's island CSS last, so a component can override a primitive without !important.
*@
<script>
    // Runs before the stylesheets on purpose: CSS does not paint until they load, so setting the
    // attribute here means the correct theme is in place for the first paint and the panel never
    // flashes light before going dark.
    //
    // 'driveunion-theme' is the same key as THEME_KEY in Scripts/theme.ts. It is repeated rather
    // than imported because this has to run before any bundle exists — keep the two in step.
    (function () {
        var stored = null;
        try {
            stored = localStorage.getItem('driveunion-theme');
        } catch (e) {
            // Private mode or storage disabled — fall through to the OS preference.
        }
        var theme = (stored === 'light' || stored === 'dark')
            ? stored
            : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
    })();
</script>
@*
    Installing this to a home screen.

    crossorigin="use-credentials" is load bearing and does not look it. A manifest is fetched
    without cookies unless the tag says otherwise, and ManifestController reads PanelCulture to
    decide which language it answers in — so without this attribute an installed app is labelled in
    the default language whatever the panel is set to. The two halves only work together.
*@
<link rel="manifest" href="~/manifest.webmanifest" crossorigin="use-credentials" />

@*
    The status bar's colour, twice, because the manifest may only carry one and a panel that follows
    the system theme would have the wrong one half the time. A browser that understands these
    prefers them over the manifest's theme_color.
*@
<meta name="theme-color" content="@BrandColours.LightBackground" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="@BrandColours.DarkBackground" media="(prefers-color-scheme: dark)" />

@*
    iOS, which reads none of the above for the icon.

    apple-touch-icon is the only icon Safari uses for a home screen, and it must be a PNG — an SVG
    here is ignored and the phone screenshots the page instead, which is how a home screen ends up
    with a tiny picture of a sign-in form on it. No rounded corners in the file: iOS masks it itself,
    and one that arrives pre-rounded is rounded twice.

    apple-mobile-web-app-capable is the older spelling of display: standalone. Recent iOS honours the
    manifest, older iOS honours only this, and there is no cost to saying both.

    black-translucent puts the page under the status bar rather than beside it, which is what makes
    the app fill the screen — and it is exactly why M2 has to add env(safe-area-inset-*) to the
    header. Until it does, the header sits under the clock.
*@
<link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="@UiText.Pwa.ShortName" />

@*
    The tab icon. SVG first for anything current — one file, sharp at every size, and it follows no
    theme so it reads on a light or a dark tab strip. The PNG is for what cannot read it.
*@
<link rel="icon" href="~/icons/icon.svg" type="image/svg+xml" />
<link rel="icon" href="~/icons/favicon-32.png" sizes="32x32" type="image/png" />

@* Same-origin, and still crossorigin: fonts are fetched in CORS mode whatever the origin, and
   without the attribute the browser downloads the file twice. *@
<link rel="preload" href="~/fonts/Vazirmatn-Variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
@if (Vite.UseDevServer)
{
    <script type="module" src="@(Vite.DevServerUrl)/@@vite/client"></script>
    <script type="module" src="@(Vite.DevServerUrl)/Scripts/main.ts"></script>
}
else
{
    foreach (var css in viteCss)
    {
        <link rel="stylesheet" href="@css" />
    }
    @* No bundle is a degraded page, not a broken one: the shell above is server-rendered CSS and
       every island's mount point carries a working fallback. Rendering nothing here is correct. *@
    if (viteJs is not null)
    {
        <script type="module" src="@viteJs"></script>
    }
}
