@model DriveUnion.Web.Models.WatchViewModel
@*
    The player, and the two ways into it.

    One partial for both the panel's watch page and the public one. What differs between them is
    where the bytes come from and where «back» goes, and those arrive on the model — a second copy of
    this markup would be a second place for the unlock flow to drift.

    The stage is a 16/9 box rather than a bare <video>. A media element with no source has no
    intrinsic size, so before play is pressed it collapses to nothing and the page jumps by the height
    of a film the moment it starts — which on a phone throws the controls under the reader's thumb
    just as they reach for them.

    That ratio is a floor and not a height, and the difference is the whole of why locked films could
    not be played: the unlock card below is taller than 16/9 is at any phone width, and a stage that
    could not grow clipped the Unlock button off the bottom of itself. See `.watch-stage` in app.css.
*@
<div class="watch"
     data-island="file-player"
     data-player-url="@Model.ContentUrl"
     data-player-mime="@Model.MimeType"
     data-player-header="@(Model.EncryptionJson ?? string.Empty)"
     data-player-working="@UiText.Player.Unlocking"
     data-player-wrong-key="@UiText.Player.WrongKey"
     data-player-no-worker="@UiText.Player.NoWorker"
     data-player-title="@Model.Title"
     data-player-watch="@Context.Request.Path"
     data-player-bytes="@Model.SizeBytes"
     data-player-keep-text="@UiText.Offline.Keep"
     data-player-keeping="@UiText.Offline.Keeping"
     data-player-keep-failed="@UiText.Offline.KeepFailed"
     data-player-keep-stopped="@UiText.Offline.KeepStopped"
     data-player-continue="@UiText.Offline.Continue"
     data-player-leaving-stops="@UiText.Offline.LeavingStopsIt"
     data-player-cannot-keep="@UiText.Offline.CannotKeep"
     data-player-no-room="@UiText.Offline.NoRoom"
     data-player-needs="@UiText.Offline.NeedsAndHas"
     data-player-free="@UiText.Offline.FreeHere"
     data-player-needs-unlock="@UiText.Player.LockedTitle">

    <div class="watch-stage @(Model.IsVideo ? null : "watch-stage--audio")">
        @if (Model.IsVideo)
        {
            <video data-player-media class="watch-media" controls playsinline preload="metadata" hidden></video>
        }
        else
        {
            <audio data-player-media class="watch-media" controls preload="metadata" hidden></audio>
        }

        @if (Model.IsLocked)
        {
            @*
                The unlock card, centred on the stage. It is the page's whole content until the
                passphrase is right, which is the point of this being a page: the same three states —
                ask, wait, play — were previously a row under a file summary.

                Hidden and revealed by the script, because there is no unlocking without one and a
                form that cannot do anything is worse than no form.
            *@
            <form data-player-form class="watch-gate" hidden>
                <span class="watch-gate-icon" aria-hidden="true">🔒</span>

                <p class="watch-gate-title">@UiText.Player.LockedTitle</p>
                <p class="watch-gate-hint">@UiText.Player.LockedHint</p>

                <label class="visually-hidden" for="watch-secret">@UiText.Player.SecretLabel</label>
                <input id="watch-secret"
                       data-player-secret
                       type="password"
                       class="control watch-gate-field"
                       autocomplete="off"
                       placeholder="@UiText.Player.SecretLabel" />

                <button type="submit" class="btn btn--primary btn--block">@UiText.Player.UnlockAndPlay</button>

                <p class="watch-gate-said" data-player-said role="status"></p>
            </form>
        }
        else
        {
            @*
                A play button and not an autoloading element. Opening a page must not start spending
                the workspace's traffic on a film nobody has asked for yet — and on a phone that is
                somebody's data as well as somebody's allowance.
            *@
            <button type="button" data-player-start class="watch-play" hidden>
                <span class="watch-play-glyph" aria-hidden="true">▶</span>
                <span>@UiText.Player.Play</span>
            </button>
        }

        <noscript>
            <p class="watch-gate-hint">@UiText.Player.NeedsScript</p>
        </noscript>
    </div>

    <div class="watch-meta">
        <h1 class="watch-title" dir="auto">@Model.Title</h1>
        <p class="watch-facts">
            <span class="mono" dir="ltr">@Model.SizeText</span>
            <span aria-hidden="true">·</span>
            <span class="mono" dir="ltr">@Model.KindText</span>
        </p>

        @*
            Keeping a copy on the device, which is the answer to a film that stalls.

            Both controls start hidden and the script reveals whichever one is true: there is a saved
            copy, or there is not. Server-rendered visible, either would be a control that lies on
            the way in — the server has no idea what this browser is holding, and cannot: that is the
            point of it being the device's own storage.

            The warning is beside the button rather than after it. What the saved copy costs is that
            it opens without the passphrase, and the only person who can weigh that is the one about
            to press it.
        *@
        <div class="watch-keep">
            <button type="button" data-player-keep class="btn btn--sm" hidden>
                @UiText.Offline.Keep
            </button>

            <button type="button" data-player-forget class="btn btn--sm" hidden>
                @UiText.Offline.Forget
            </button>

            <button type="button" data-player-stop class="btn btn--sm btn--danger" hidden>
                @UiText.Offline.StopKeeping
            </button>

            <p class="watch-keep-said" data-player-kept hidden>
                @UiText.Offline.Kept
            </p>

            @*
                How far it has got, which a button alone cannot say.

                On a six-gigabyte film this runs for ten minutes or more, and without it the only
                information the reader has is that nothing appears to be happening — so they press it
                again, or close the tab. Both figures and the bar, because a percentage on its own
                does not tell somebody whether the next fifteen minutes are worth waiting through.
            *@
            <div class="watch-keep-progress" data-player-progress hidden>
                <div class="bar" role="progressbar" data-player-bar
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                    <span class="bar-fill" data-player-bar-fill style="inline-size: 0%;"></span>
                </div>

                @*
                    Four figures, and each answers a different question: how far (percent), how much
                    (bytes), whether the connection is working (rate) and whether to wait for it
                    (time left). «14 MB/s» on a six-gigabyte film still leaves arithmetic to do, so
                    the last one is not a decoration.

                    The rate and the time are empty until there is a window to measure over, rather
                    than showing a wild first figure and settling down.
                *@
                <p class="watch-keep-figures">
                    <span class="mono" dir="ltr" data-player-percent>0%</span>
                    <span class="mono" dir="ltr" data-player-sofar></span>
                    <span class="mono" dir="ltr" data-player-speed></span>
                    <span class="mono" dir="ltr" data-player-left></span>
                </p>
            </div>

            @if (Model.IsLocked)
            {
                <p class="watch-keep-warns">@UiText.Offline.KeptOpensWithoutTheKey</p>
            }
        </div>

        <a class="btn btn--sm" href="@Model.BackUrl">@Model.BackText</a>
    </div>
</div>
