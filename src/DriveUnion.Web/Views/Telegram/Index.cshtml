@using DriveUnion.Web.Models
@model TelegramOperatorPageViewModel
@{
    ViewData["Title"] = "ربات تلگرام";
}

@*
    accounts.css carries the setup panel's steps, state rows and form — the same shapes this screen
    needs and the same ones the Google setup panel draws. Linked here rather than in the head because
    _Layout has no head section to extend; the browser blocks rendering of what follows while it
    loads, so there is nothing to flash.
*@
<link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />

@*
    The operator's screen, and the whole of what it may say about the people using the bot is the two
    counts below.

    There is no list here, no chat id, no customer @username and no filename — and there is nothing
    behind this view that could render one either: ITelegramOperatorView returns two integers. A
    cross-tenant directory of customers' messenger identities is a privacy surface with no product
    use behind it, and the absence is enforced by the read model rather than by this file's restraint.
*@
<div class="stack" style="gap: 16px;">
    <div class="stack" style="gap: 4px;">
        <h1 class="page-title">ربات تلگرام</h1>
        <p class="page-sub">توکن ربات رمزنگاری‌شده روی سرور ذخیره می‌شود.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <p class="page-sub" role="status">@Model.Notice</p>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="page-sub danger" role="alert">@Model.Error</p>
    }

    <div class="card card--pad" style="max-width: 900px;">
        <div class="row" style="gap: 12px; align-items: baseline;">
            <span class="card-title">راه‌اندازی ربات</span>
            <span class="@(Model.IsComplete ? "badge" : "badge badge--warn") push-end">
                @(Model.IsComplete ? "آماده" : "ناقص")
            </span>
        </div>

        @*
            Written out rather than linked to Telegram's documentation: that documentation is in
            English, and the four steps below are the whole of what the operator has to do.
        *@
        <ol class="setup-steps" style="margin-top: 14px;">
            <li>
                در تلگرام به <a href="https://t.me/BotFather" target="_blank" rel="noopener noreferrer">@@BotFather</a>
                پیام دهید و با <span class="mono" dir="ltr">/newbot</span> یک ربات بسازید.
            </li>
            <li>
                توکنی که می‌دهد را در کادر زیر بگذارید. توکن مانند
                <span class="mono" dir="ltr">123456789:AA…</span> است و همان‌جا نام کاربری ربات هم
                گفته می‌شود.
            </li>
            <li>
                با <span class="mono" dir="ltr">/setjoingroups</span> افزودن ربات به گروه‌ها را
                <strong>ببندید</strong>. این ربات فقط در گفتگوی خصوصی کار می‌کند، و رباتی که بتوان به
                گروه اضافه‌اش کرد، اضافه خواهد شد.
            </li>
            <li>
                با <span class="mono" dir="ltr">/setprivacy</span> حالت حریم خصوصی را
                <strong>روشن</strong> بگذارید.
            </li>
        </ol>

        <div class="setup-state" role="group" aria-label="وضعیت فعلی" style="margin-top: 14px;">
            <div class="setup-state-row">
                <span class="setup-state-label">توکن</span>
                @* Never the value. «ذخیره شده» is the whole of what a browser is ever told: a screen
                   that could print the token is a screen that eventually will. *@
                <span class="setup-state-value">@(Model.HasToken ? "ذخیره شده" : "—")</span>
                <span class="@(Model.HasToken ? "badge" : "badge badge--warn")">
                    @(Model.HasToken ? "تنظیم شده" : "تنظیم نشده")
                </span>
            </div>
            <div class="setup-state-row">
                <span class="setup-state-label">نام کاربری</span>
                <span class="setup-state-value mono" dir="ltr">
                    @(string.IsNullOrEmpty(Model.BotUsername) ? "—" : "@" + Model.BotUsername)
                </span>
                <span class="@(string.IsNullOrEmpty(Model.BotUsername) ? "badge badge--warn" : "badge")">
                    @(string.IsNullOrEmpty(Model.BotUsername) ? "تنظیم نشده" : "تنظیم شده")
                </span>
            </div>
            <div class="setup-state-row">
                @* The bot's own numeric id, read out of the token rather than asked for. It is the
                   operator's own identifier and names no customer. *@
                <span class="setup-state-label">شناسه ربات</span>
                <span class="setup-state-value mono" dir="ltr">@(Model.BotUserId?.ToString() ?? "—")</span>
                <span class="badge badge--muted">از توکن</span>
            </div>
        </div>

        <form class="setup-form" method="post" action="@Url.Action("SaveBot", "Telegram")" style="margin-top: 14px;">
            @Html.AntiForgeryToken()

            <div class="stack" style="gap: 4px;">
                <label class="field-label" for="telegram-token">توکن ربات</label>
                @*
                    type=password so a shoulder or a screen share does not read it, and no value
                    attribute ever. Blank means «unchanged», which the placeholder says — so
                    correcting the @username does not cost a trip back to @BotFather.
                *@
                <span class="field">
                    <input id="telegram-token"
                           name="BotToken"
                           type="password"
                           dir="ltr"
                           autocomplete="off"
                           spellcheck="false"
                           placeholder="@(Model.HasToken ? "ذخیره شده — برای تغییر مقدار تازه وارد کنید" : "123456789:AA…")" />
                </span>
            </div>

            <div class="stack" style="gap: 4px;">
                <label class="field-label" for="telegram-username">نام کاربری ربات</label>
                <span class="field">
                    <input id="telegram-username"
                           name="BotUsername"
                           dir="ltr"
                           autocomplete="off"
                           spellcheck="false"
                           placeholder="DriveUnionBot"
                           value="@Model.BotUsername" />
                </span>
                <span class="setup-hint">پیوند اتصال هر مشتری از همین نام ساخته می‌شود.</span>
            </div>

            <div class="row" style="gap: 8px;">
                <button type="submit" class="btn btn--primary">ذخیره</button>

                @if (Model.UpdatedText is { Length: > 0 } updated)
                {
                    <span class="setup-hint push-end">آخرین تغییر: @updated</span>
                }
            </div>
        </form>

        @if (Model.HasToken)
        {
            @* getMe is the only proof a token works. Until this button existed the screen had the
               bot id (parsed out of the token) and the @username (typed by the operator), which is
               enough to build a working deep link and is not evidence the token is live. *@
            <form method="post" action="@Url.Action("VerifyBot", "Telegram")" style="margin-top: 12px;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn--sm">تأیید توکن</button>
                <span class="setup-hint">از تلگرام می‌پرسد این توکن به کدام ربات تعلق دارد.</span>
            </form>
        }

        @if (Model.HasToken || !string.IsNullOrEmpty(Model.BotUsername))
        {
            @* A separate form, because a delete inside the save form is one stray Enter away from
               being the button that submits. *@
            <form method="post" action="@Url.Action("ClearBot", "Telegram")" style="margin-top: 12px;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn--danger btn--sm">حذف اطلاعات ربات</button>
            </form>
        }
    </div>

    <div class="card card--pad" style="max-width: 900px;">
        <div class="row" style="gap: 12px; align-items: baseline;">
            <span class="card-title">دریافت پیام‌ها</span>
            <span class="badge badge--muted push-end">@Model.UpdateModeText</span>
        </div>

        @*
            Which server we talk to is deployment configuration and is shown here, not editable. A
            dropdown whose wrong value is an irreversible ten-minute logOut — and whose right value
            nobody can verify from a browser — is a control that should not exist.
        *@
        <div class="setup-state" role="group" aria-label="وبهوک" style="margin-top: 12px;">
            <div class="setup-state-row">
                <span class="setup-state-label">وبهوک</span>
                <span class="setup-state-value">@(Model.WebhookRegisteredText ?? "—")</span>
                <span class="@(Model.HasWebhook ? "badge" : "badge badge--warn")">
                    @(Model.HasWebhook ? "ثبت شده" : "ثبت نشده")
                </span>
            </div>

            @if (Model.Webhook is { } hook)
            {
                <div class="setup-state-row">
                    <span class="setup-state-label">در انتظار</span>
                    <span class="setup-state-value">@hook.PendingUpdateCountText</span>
                    <span class="@(hook.IsBacklogged ? "badge badge--warn" : "badge badge--muted")">
                        @(hook.IsBacklogged ? "انباشته شده" : "عادی")
                    </span>
                </div>

                @if (hook.LastErrorMessage is { Length: > 0 } lastError)
                {
                    @* Verbatim, in Telegram's own words and its own language. It is Telegram saying
                       why it could not reach us, and paraphrasing it throws away the only diagnosis
                       there is. *@
                    <div class="setup-state-row">
                        <span class="setup-state-label">آخرین خطا</span>
                        <span class="setup-state-value mono" dir="ltr">@lastError</span>
                        <span class="badge badge--warn">@(hook.LastErrorText ?? "—")</span>
                    </div>
                }
            }
        </div>

        @if (Model.HasToken)
        {
            <div class="row" style="gap: 8px; margin-top: 12px;">
                <form method="post" action="@Url.Action("RegisterWebhook", "Telegram")">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn--sm">ثبت وبهوک</button>
                </form>

                @if (Model.HasWebhook)
                {
                    <form method="post" action="@Url.Action("ClearWebhook", "Telegram")">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn--sm btn--danger">حذف وبهوک</button>
                    </form>
                }
            </div>
        }
    </div>

    <div class="card card--pad" style="max-width: 900px;">
        <span class="card-title">سرور تلگرام</span>

        <div class="setup-state" role="group" aria-label="سرور" style="margin-top: 12px;">
            <div class="setup-state-row">
                <span class="setup-state-label">نقطه‌ی اتصال</span>
                <span class="setup-state-value mono" dir="ltr">@Model.Server.ApiBaseUrl</span>
                <span class="badge badge--muted">@Model.Server.ModeText</span>
            </div>

            @if (Model.Server.HasWorkDirectory)
            {
                @*
                    The alarm that ends the feature. In a healthy production this is at or near zero,
                    because the local copy is deleted the instant a transfer finishes; a size that
                    stays above zero across several minutes means that has stopped, and the volume
                    this shares with the upload spool and the database is what fills.
                *@
                <div class="setup-state-row">
                    <span class="setup-state-label">پوشه‌ی کاری</span>
                    <span class="setup-state-value mono" dir="ltr">@Model.Server.WorkDirectoryBytesText</span>
                    <span class="@(Model.Server.IsHoarding ? "badge badge--warn" : "badge")">
                        @(Model.Server.IsHoarding ? "خالی نمی‌شود" : "خالی")
                    </span>
                </div>
                <div class="setup-state-row">
                    <span class="setup-state-label">تعداد فایل</span>
                    <span class="setup-state-value">@Model.Server.WorkDirectoryFilesText</span>
                    <span class="badge badge--muted">@(Model.Server.OldestFileAgeText ?? "—")</span>
                </div>
                <div class="setup-state-row">
                    <span class="setup-state-label">فضای آزاد</span>
                    <span class="setup-state-value mono" dir="ltr">@(Model.Server.FreeBytesText ?? "—")</span>
                    <span class="badge badge--muted">مشترک با فضای موقت آپلود</span>
                </div>
            }
        </div>

        <p class="setup-note" style="margin-top: 12px;">
            مسیر پوشه‌ی کاری اینجا نشان داده نمی‌شود؛ نامش به کار هیچ صفحه‌ای نمی‌آید.
        </p>
    </div>

    <div class="card card--pad" style="max-width: 900px;">
        <span class="card-title">وضعیت</span>

        <div class="setup-state" role="group" aria-label="شمارش‌ها" style="margin-top: 12px;">
            <div class="setup-state-row">
                <span class="setup-state-label">حساب‌های متصل</span>
                <span class="setup-state-value">@Model.LinkedCountText</span>
                <span class="badge badge--muted">کل</span>
            </div>
            <div class="setup-state-row">
                <span class="setup-state-label">درخواست‌های در جریان</span>
                <span class="setup-state-value">@Model.PendingCountText</span>
                <span class="badge badge--muted">۱۰ دقیقه‌ای</span>
            </div>
            <div class="setup-state-row">
                <span class="setup-state-label">صف ارسال</span>
                <span class="setup-state-value">@Model.OutboxDepthText</span>
                <span class="badge badge--muted">در انتظار</span>
            </div>
            <div class="setup-state-row">
                <span class="setup-state-label">پیام‌های پردازش‌شده</span>
                <span class="setup-state-value">@Model.UpdatesLastDayText</span>
                <span class="badge badge--muted">۲۴ ساعت</span>
            </div>
            <div class="setup-state-row">
                <span class="setup-state-label">ارسال‌های ناموفق</span>
                <span class="setup-state-value">@Model.SendsFailedLastDayText</span>
                <span class="badge badge--muted">۲۴ ساعت</span>
            </div>
        </div>

        @*
            Said out loud so nobody goes looking for the list that is not here, and so the next person
            to build this screen knows it was refused rather than forgotten.
        *@
        <p class="setup-note" style="margin-top: 12px;">
            این صفحه نام، شناسه یا فایل هیچ مشتری‌ای را نشان نمی‌دهد و نمی‌تواند نشان بدهد. فهرست
            حساب‌های تلگرام مشتری‌ها ساخته نمی‌شود.
        </p>
    </div>
</div>
