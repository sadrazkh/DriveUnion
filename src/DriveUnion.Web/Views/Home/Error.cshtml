@using DriveUnion.Web.Models
@model ErrorViewModel
@{
    ViewData["Title"] = UiText.Home.ErrorTitle;
}

<div class="card card--pad" style="max-width: 560px;">
    <h1 class="page-title" style="margin-bottom: 8px;">@UiText.Home.ErrorHeading</h1>
    <p class="page-sub" style="margin-bottom: 14px;">
        @UiText.Home.ErrorBody
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="mono muted" dir="ltr" style="font-size: 11.5px;">@Model.RequestId</p>
    }

    <a class="btn btn--primary" href="@Url.Action("Index", "Files")">@UiText.Files.BackToFiles</a>
</div>
