@using DriveUnion.Web.Models
@model ErrorViewModel
@{
    ViewData["Title"] = "خطا";
}

<div class="card card--pad" style="max-width: 560px;">
    <h1 class="page-title" style="margin-bottom: 8px;">خطایی رخ داد</h1>
    <p class="page-sub" style="margin-bottom: 14px;">
        درخواست شما کامل نشد. اگر دوباره تکرار شد، شناسه زیر را برای پشتیبانی بفرستید.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="mono muted" dir="ltr" style="font-size: 11.5px;">@Model.RequestId</p>
    }

    <a class="btn btn--primary" href="@Url.Action("Index", "Files")">بازگشت به فایل‌ها</a>
</div>
