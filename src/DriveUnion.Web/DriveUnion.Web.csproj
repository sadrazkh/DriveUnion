<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Where the Postgres password and the Google client secret live in development. They are held
      outside the repository on purpose; production reads the same keys from the environment.
    -->
    <UserSecretsId>e40bef44-41b0-42f8-b5ca-cb425fd40bb7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DriveUnion.Core\DriveUnion.Core.csproj" />
    <ProjectReference Include="..\DriveUnion.Infrastructure\DriveUnion.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- node_modules is enormous and must never reach the publish output or the file watcher. -->
    <Content Remove="node_modules\**" />
    <None Remove="node_modules\**" />
    <Compile Remove="node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DriveUnion.Tests" />
  </ItemGroup>

</Project>
