@model AccessDeniedViewModel
@{
    ViewData["Title"] = Model.HasWorkspace || Model.IsOperator
        ? UiText.Identity.NoAccessTitle
        : UiText.Identity.NoWorkspaceTitle;
}

<div class="stack" style="gap: 16px; max-width: 520px;">
    @if (!Model.HasWorkspace && !Model.IsOperator)
    {
        <div class="stack" style="gap: 4px;">
            <h1 class="page-title">@UiText.Identity.NoWorkspaceHeading</h1>
            <p class="page-sub">@UiText.Identity.NoWorkspaceSubtitle</p>
        </div>

        <div class="card card--pad">
            <p class="page-sub" style="margin: 0;">
                @UiText.Identity.NoWorkspaceBody
            </p>
        </div>
    }
    else if (Model.IsOperator)
    {
        @* Operator staff have no tenant, so every customer screen refuses them — correctly, and
           confusingly if it is not said out loud. *@
        <div class="stack" style="gap: 4px;">
            <h1 class="page-title">@UiText.Identity.OperatorHasNoWorkspaceHeading</h1>
            <p class="page-sub">@UiText.Identity.OperatorHasNoWorkspaceSubtitle</p>
        </div>

        <div class="card card--pad">
            <a class="btn btn--primary btn--lg" href="/Accounts">@UiText.Identity.GoToGoogleAccounts</a>
        </div>
    }
    else
    {
        @* A customer. Nothing here names the operator's screens or what is on them: the product
           rests on a customer never learning that a Google account is involved (spec §1), and a
           refusal that explains what it is refusing gives that away. *@
        <div class="stack" style="gap: 4px;">
            <h1 class="page-title">@UiText.Identity.ForbiddenHeading</h1>
            <p class="page-sub">@UiText.Identity.ForbiddenSubtitle</p>
        </div>

        <div class="card card--pad">
            <a class="btn btn--primary btn--lg" href="/Files">@UiText.Identity.BackToFiles</a>
        </div>
    }

    <p class="page-sub" style="font-size: 12px;">
        @UiText.Identity.SignedInAsSomebodyElse
        <a href="@Url.Action("Logout", "Account", new { area = "Identity" })">@UiText.Identity.SignOutHeading</a>
    </p>
</div>
