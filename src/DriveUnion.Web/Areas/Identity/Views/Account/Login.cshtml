@model LoginViewModel
@{
    ViewData["Title"] = "ورود";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).ToList();
}

<div class="stack" style="gap: 16px; max-width: 420px;">
    <div class="stack" style="gap: 4px;">
        <h1 class="page-title">ورود به پنل</h1>
        <p class="page-sub">حساب‌ها را اپراتور می‌سازد؛ ثبت‌نام عمومی وجود ندارد.</p>
    </div>

    <div class="card card--pad">
        @* Literal action rather than asp-controller/asp-action, like the rest of the panel: link
           generation throws when the pair is not registered, and a sign-in form that cannot render
           locks everyone out of everything. *@
        <form method="post"
              action="@Url.Action("Login", "Account", new { area = "Identity" })"
              class="stack"
              style="gap: 14px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            @if (errors.Count > 0)
            {
                <p class="page-sub" role="alert" style="color: var(--danger); margin: 0;">
                    @foreach (var error in errors)
                    {
                        <span style="display: block;">@error.ErrorMessage</span>
                    }
                </p>
            }

            <div>
                <label class="field-label" for="login-email">ایمیل</label>
                @* dir="ltr" on the inputs and nowhere else: the page is Persian, the credentials
                   are Latin, and a right-to-left password box puts the caret on the wrong side. *@
                <span class="field">
                    <input id="login-email"
                           name="Email"
                           type="email"
                           dir="ltr"
                           value="@Model.Email"
                           autocomplete="username"
                           autofocus
                           required />
                </span>
            </div>

            <div>
                <label class="field-label" for="login-password">گذرواژه</label>
                <span class="field">
                    <input id="login-password"
                           name="Password"
                           type="password"
                           dir="ltr"
                           autocomplete="current-password"
                           required />
                </span>
            </div>

            <label class="row" style="gap: 8px; font-size: 12.5px;">
                <input type="checkbox" name="RememberMe" value="true" @(Model.RememberMe ? "checked" : null) />
                <span>مرا به خاطر بسپار</span>
            </label>

            <button type="submit" class="btn btn--primary btn--lg btn--block">ورود</button>
        </form>
    </div>

    @* True as of M1: there is no mail sender and no reset flow, so pointing at a "forgot password"
       link nobody built would be worse than saying what actually has to happen. *@
    <p class="page-sub" style="font-size: 12px;">
        بازنشانی گذرواژه از داخل پنل ممکن نیست. اگر گذرواژه‌تان را ندارید، از اپراتور بخواهید.
    </p>
</div>
