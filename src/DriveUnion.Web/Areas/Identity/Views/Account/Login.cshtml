@model LoginViewModel
@{
    ViewData["Title"] = UiText.Identity.SignInTitle;
    var returnUrl = ViewData["ReturnUrl"] as string;
    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).ToList();
}

<div class="stack" style="gap: 16px; max-width: 420px;">
    <div class="stack" style="gap: 4px;">
        <h1 class="page-title">@UiText.Identity.SignInHeading</h1>
        <p class="page-sub">@UiText.Identity.SignInSubtitle</p>
    </div>

    <div class="card card--pad">
        @* Literal action rather than asp-controller/asp-action, like the rest of the panel: link
           generation throws when the pair is not registered, and a sign-in form that cannot render
           locks everyone out of everything. *@
        <form method="post"
              action="@Url.Action("Login", "Account", new { area = "Identity" })"
              class="stack"
              style="gap: 14px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            @if (errors.Count > 0)
            {
                @* dir="auto" per line: these sentences follow the panel's language, but an error
                   that names an address or a value the visitor typed can be Latin inside a Persian
                   page, and the line should sit the way its own text reads. *@
                <p class="page-sub" role="alert" style="color: var(--danger); margin: 0;">
                    @foreach (var error in errors)
                    {
                        <span style="display: block;" dir="auto">@error.ErrorMessage</span>
                    }
                </p>
            }

            <div>
                <label class="field-label" for="login-email">@UiText.Identity.Email</label>
                @* dir="ltr" on the inputs and nowhere else: the credentials are Latin whatever the
                   page's language, and a right-to-left password box puts the caret on the wrong
                   side. In English the attribute is simply what the document already does. *@
                <span class="field">
                    <input id="login-email"
                           name="Email"
                           type="email"
                           dir="ltr"
                           value="@Model.Email"
                           autocomplete="username"
                           autofocus
                           required />
                </span>
            </div>

            <div>
                <label class="field-label" for="login-password">@UiText.Identity.Password</label>
                <span class="field">
                    <input id="login-password"
                           name="Password"
                           type="password"
                           dir="ltr"
                           autocomplete="current-password"
                           required />
                </span>
            </div>

            <div class="stack" style="gap: 6px;">
                <label class="row" style="gap: 8px; font-size: 12.5px;">
                    <input type="checkbox" name="RememberMe" value="true" @(Model.RememberMe ? "checked" : null) />
                    <span>@UiText.Identity.RememberMe</span>
                </label>

                @* The hidden field is not decoration and cannot be dropped. An unticked checkbox
                   posts nothing at all, and MVC leaves a property it finds no value for at its
                   initialiser — which is now true. Without this line the box would render ticked,
                   post nothing when somebody unticked it, and bind to true anyway: the one control
                   that protects a person on a shared computer would do exactly nothing, silently.

                   After the checkbox, not before it. Both go on the wire under one name, and the
                   binder takes the first value — so the order is what makes a ticked box mean true.
                   It is the pair and the order Razor's own asp-for emits for a bool. *@
                <input type="hidden" name="RememberMe" value="false" />

                @* Said here rather than in a help page nobody opens: the moment this matters is the
                   moment somebody is typing a password into a machine that is not theirs. *@
                <p class="page-sub" style="font-size: 12px; margin: 0;">
                    @UiText.SignIn.StaySignedInHint(Model.StaySignedInDays)
                </p>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--block">@UiText.Identity.SignInTitle</button>
        </form>
    </div>

    @* True as of M1: there is no mail sender and no reset flow, so pointing at a "forgot password"
       link nobody built would be worse than saying what actually has to happen. *@
    <p class="page-sub" style="font-size: 12px;">
        @UiText.Identity.NoPasswordReset
    </p>
</div>
